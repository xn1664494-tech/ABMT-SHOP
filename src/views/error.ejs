        <p style="margin: 16px 0 24px;">Đã xảy ra sự cố khi xử lý yêu cầu của bạn.</p>
        <a href="/" class="btn btn-primary">Về trang chủ</a>
      </div>
    </section>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
