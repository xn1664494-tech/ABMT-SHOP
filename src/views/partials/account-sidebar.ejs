<%
  var accUser = (typeof user !== 'undefined' && user) ? user : ((locals && locals.user) || {});
  var accTab = (typeof tab !== 'undefined' && tab) ? tab : 'overview';
  var accHasProcessing = typeof processingCount !== 'undefined' && processingCount !== null;
  var accProcessing = accHasProcessing ? (Number(processingCount) || 0) : 0;
  var accName = String(accUser.name || '');
  var accEmail = String(accUser.email || '');
  var accInitial = accName.trim() ? accName.trim().charAt(0).toUpperCase() : '?';
  var accRole = accUser.role || '';
  var accMenu = [
    { key: 'overview', label: 'Tổng quan', href: '/account?tab=overview' },
    { key: 'orders', label: 'Đơn hàng', href: '/account?tab=orders' },
    { key: 'addresses', label: 'Sổ địa chỉ', href: '/account?tab=addresses' },
    { key: 'profile', label: 'Hồ sơ', href: '/account?tab=profile' }
  ];
%>
<aside class="acc-sidebar" aria-label="Điều hướng tài khoản">
  <div class="acc-user">
    <span class="acc-avatar" aria-hidden="true"><%= accInitial %></span>
    <div class="acc-user-meta">
      <p class="acc-user-name"><%= accName || 'Tài khoản' %></p>
      <% if (accEmail) { %><p class="acc-user-email"><%= accEmail %></p><% } %>
    </div>
  </div>

  <nav class="acc-menu" aria-label="Menu tài khoản">
    <% accMenu.forEach(function (item) { %>
      <a
        class="acc-menu-link<%= accTab === item.key ? ' is-active' : '' %>"
        href="<%= item.href %>"
        <%= accTab === item.key ? 'aria-current="page"' : '' %>
      >
        <span><%= item.label %></span>
        <% if (item.key === 'orders' && accHasProcessing) { %>
          <span class="acc-menu-badge"><%= accProcessing %></span>
        <% } %>
      </a>
    <% }) %>
    <% if (accRole === 'admin') { %>
      <a class="acc-menu-link" href="/admin">Vào trang quản trị</a>
    <% } %>
  </nav>

  <button type="button" class="acc-logout" data-action="logout">Đăng xuất</button>
</aside>
