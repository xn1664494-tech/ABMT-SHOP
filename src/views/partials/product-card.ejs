<article class="product-card" id="product-<%= product.slug %>">
  <a href="/products/<%= product.slug %>" class="product-link">
    <div class="product-thumb<%= locals.badge || locals.rank || product.outOfStock ? ' has-badge' : '' %>">
      <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" decoding="async" width="300" height="400">
      <% if (product.outOfStock) { %>
        <span class="badge badge-sale">Hết hàng</span>
      <% } else if (locals.badge) { %>
        <span class="badge <%= locals.badge === 'Giảm giá' ? 'badge-sale' : 'badge-soft' %>"><%= locals.badge %></span>
      <% } %>
      <% if (locals.rank) { %>
        <span class="badge badge-count"><%= locals.rank %></span>
      <% } %>
    </div>
    <div class="product-info">
      <h3 class="product-name"><%= product.name %></h3>
      <div class="product-price">
        <% if (product.salePrice) { %>
          <span class="price-current"><%= product.salePrice.toLocaleString('vi-VN') %>₫</span>
          <span class="price-old"><%= product.price.toLocaleString('vi-VN') %>₫</span>
        <% } else { %>
          <span class="price-current"><%= product.price.toLocaleString('vi-VN') %>₫</span>
        <% } %>
      </div>
    </div>
  </a>
</article>
