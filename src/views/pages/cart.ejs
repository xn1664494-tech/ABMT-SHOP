<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <div data-flash data-type="info" hidden></div>
  <%
    var L = (locals && locals.locals) ? locals.locals : (locals || {});
    var items = Array.isArray(L.items) ? L.items : [];
    var isEmpty = Boolean(L.empty) || items.length === 0;
    var count = Number(L.count) || 0;
    var subtotal = Number(L.subtotal) || 0;
    var shippingFee = Number(L.shippingFee) || 0;
    var total = Number(L.total) || 0;
  %>
  <main id="main-content" class="main-content">
    <div class="container page-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <span aria-current="page">Giỏ hàng</span>
      </nav>

      <div class="page-head">
        <div>
          <h1 class="page-title">Giỏ hàng</h1>
          <p class="page-sub">Kiểm tra sản phẩm trước khi thanh toán</p>
        </div>
      </div>

      <div id="empty" class="empty-state"<%= isEmpty ? '' : ' hidden' %>>
        <p class="empty-state-title">Giỏ hàng đang trống</p>
        <p class="empty-state-text">Hãy thêm vài món đồ bạn thích để bắt đầu mua sắm.</p>
        <a href="/catalog" class="btn btn-primary">Khám phá sản phẩm</a>
      </div>

      <div id="full"<%= isEmpty ? ' hidden' : '' %>>
        <div class="cart-layout">
          <div id="lines" class="cart-lines">
            <% items.forEach(function (item) {
              var itemId = item._id ? String(item._id) : (item.sku || '');
              var product = item.product || {};
              var productName = product.name || item.sku || 'Sản phẩm';
              var productSlug = product.slug || '';
              var productImage = Array.isArray(product.images) && product.images[0]
                ? product.images[0]
                : '/images/placeholder/product.svg';
              var variants = Array.isArray(product.variants) ? product.variants : [];
              var variant = variants.find(function (v) { return v.sku === item.sku; });
              var maxStock = variant ? Number(variant.stock) || 0 : 0;
              var unitPrice = Number(item.unitPrice) || 0;
              var qty = Number(item.qty) || 1;
            %>
              <article class="cart-line" data-item-id="<%= itemId %>" data-sku="<%= item.sku %>">
                <div class="cart-thumb">
                  <img src="<%= productImage %>" alt="<%= productName %>" width="150" height="200" loading="lazy" decoding="async">
                </div>
                <div class="cart-line-main">
                  <h2 class="cart-line-name">
                    <% if (productSlug) { %>
                      <a href="/products/<%= productSlug %>"><%= productName %></a>
                    <% } else { %>
                      <%= productName %>
                    <% } %>
                  </h2>
                  <div class="cart-line-meta">
                    <span>SKU: <%= item.sku %></span>
                    <span>Kích cỡ: <%= item.size || '—' %></span>
                    <span>Màu: <%= item.color || '—' %></span>
                  </div>
                  <div class="cart-line-unit">Đơn giá: <span data-unit-price><%= unitPrice.toLocaleString('vi-VN') %>₫</span></div>
                  <div class="cart-line-controls">
                    <div class="qty-control" role="group" aria-label="Số lượng <%= productName %>">
                      <button type="button" class="qty-btn" data-action="dec" aria-label="Giảm số lượng">−</button>
                      <input type="number" class="qty-field" value="<%= qty %>" min="1" max="<%= maxStock || qty %>" data-saved="<%= qty %>" inputmode="numeric" aria-label="Số lượng <%= productName %>">
                      <button type="button" class="qty-btn" data-action="inc" aria-label="Tăng số lượng">+</button>
                    </div>
                    <a href="/checkout?item=<%= encodeURIComponent(itemId) %>" class="btn btn-primary btn-sm" data-action="checkout">Thanh toán</a>
                    <button type="button" class="btn btn-ghost btn-sm" data-action="remove">Xóa</button>
                  </div>
                </div>
                <div class="cart-line-total" data-line-total><%= (unitPrice * qty).toLocaleString('vi-VN') %>₫</div>
                <p class="cart-line-error" aria-live="polite"></p>
              </article>
            <% }) %>
          </div>

          <aside class="cart-summary" aria-label="Tóm tắt giỏ hàng">
            <div class="summary-row">
              <span>Số lượng</span>
              <span class="summary-value"><span id="count"><%= count %></span> sản phẩm</span>
            </div>
            <div class="summary-row">
              <span>Tạm tính</span>
              <span class="summary-value" id="sub"><%= subtotal.toLocaleString('vi-VN') %>₫</span>
            </div>
            <div class="summary-row">
              <span>Phí vận chuyển</span>
              <span class="summary-value" id="ship"><%= shippingFee.toLocaleString('vi-VN') %>₫</span>
            </div>
            <div class="summary-row total">
              <span>Tổng cộng</span>
              <span id="total"><%= total.toLocaleString('vi-VN') %>₫</span>
            </div>
            <a href="/checkout" class="btn btn-primary btn-block">Tiến hành thanh toán</a>
            <a href="/catalog" class="cart-continue">Tiếp tục mua sắm</a>
          </aside>
        </div>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/cart.js"></script>
</body>
</html>
