<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <div data-flash data-type="info" hidden></div>
  <%
    var p = (typeof product !== 'undefined' && product) ? product : {};
    var vs = (typeof variants !== 'undefined' && Array.isArray(variants)) ? variants : [];
    var related = (typeof productsRelated !== 'undefined' && Array.isArray(productsRelated)) ? productsRelated : [];
    var imgs = (Array.isArray(p.images) && p.images.length > 0) ? p.images : [];
    var mainImg = imgs[0];
    var uniqueSizes = [];
    vs.forEach(function (v) {
      if (v && v.size && uniqueSizes.indexOf(v.size) === -1) uniqueSizes.push(v.size);
    });
    var stockBySize = {};
    var totalStock = 0;
    vs.forEach(function (v) {
      var qty = Number(v.stock) || 0;
      totalStock += qty;
      if (v.size) stockBySize[v.size] = (stockBySize[v.size] || 0) + qty;
    });
    var descLines = String(p.description || '').split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean);
    var productId = p._id ? String(p._id) : (p.id || '');
    var basePrice = Number(p.basePrice) || 0;
  %>
  <main id="main-content" class="main-content">
    <div class="container page-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/catalog">Sản phẩm</a>
        <span class="sep">/</span>
        <span aria-current="page"><%= p.name %></span>
      </nav>

      <div class="pdp-grid">
        <div class="pdp-gallery">
          <div class="pdp-main">
            <%- include('../partials/product-art', { product: { name: p.name, image: mainImg || '', category: p.category }, index: 0 }) %>
          </div>
          <% if (imgs.length > 1) { %>
            <div class="pdp-thumbs">
              <% imgs.slice(0, 4).forEach(function (img, index) { %>
                <a class="pdp-thumb" href="<%= img %>" target="_blank" rel="noopener" aria-label="Xem ảnh <%= index + 1 %> của <%= p.name %>">
                  <img src="<%= img %>" alt="<%= p.name %> - ảnh <%= index + 1 %>" loading="lazy" decoding="async" width="150" height="150">
                </a>
              <% }) %>
            </div>
          <% } %>
        </div>

        <div class="pdp-info">
          <h1 class="pdp-name"><%= p.name %></h1>
          <div class="pdp-price" id="price"><%= basePrice.toLocaleString('vi-VN') %>₫</div>
          <div class="pdp-badges">
            <% if (totalStock > 0) { %>
              <span class="badge badge-soft">Còn hàng</span>
            <% } else { %>
              <span class="badge badge-sale">Hết hàng</span>
            <% } %>
          </div>

          <div class="variant-block">
            <div class="variant-head">
              <span>Màu sắc</span>
              <span class="variant-hint">Chọn màu để xem size còn hàng</span>
            </div>
            <div id="colors" class="variant-options" aria-label="Chọn màu sắc"></div>
          </div>

          <div class="variant-block">
            <div class="variant-head">
              <span>Kích cỡ</span>
            </div>
            <div id="sizes" class="variant-options" aria-label="Chọn kích cỡ">
              <% uniqueSizes.forEach(function (size) { %>
                <button type="button" class="btn btn-soft btn-size pill" data-size="<%= size %>" aria-disabled="true" disabled><%= size %></button>
              <% }) %>
            </div>
          </div>

          <div class="qty-row">
            <span class="qty-label" id="qty-label">Số lượng</span>
            <div class="qty-control" role="group" aria-labelledby="qty-label">
              <button type="button" id="minus" class="qty-btn" aria-label="Giảm số lượng" disabled>−</button>
              <input type="number" id="qty" class="qty-field" value="1" min="1" max="1" inputmode="numeric" aria-label="Số lượng" disabled>
              <button type="button" id="plus" class="qty-btn" aria-label="Tăng số lượng" disabled>+</button>
            </div>
          </div>

          <button type="button" id="add" class="btn btn-primary pdp-add" data-product-id="<%= productId %>" data-base-price="<%= basePrice %>" data-total-stock="<%= totalStock %>" <%= totalStock <= 0 ? 'disabled' : '' %>>Thêm vào giỏ</button>

          <div class="pdp-meta">
            <span>Mã sản phẩm: <strong id="sku">—</strong></span>
            <span>Trạng thái: <strong id="status">Chọn màu và kích cỡ</strong></span>
          </div>

          <div class="pdp-section">
            <h2 class="pdp-section-title">Mô tả sản phẩm</h2>
            <% if (descLines.length > 0) { %>
              <% descLines.forEach(function (line) { %>
                <p class="pdp-desc"><%= line %></p>
              <% }) %>
            <% } else { %>
              <p class="pdp-desc">Đang cập nhật mô tả sản phẩm.</p>
            <% } %>
          </div>

          <div class="pdp-section">
            <h2 class="pdp-section-title">Bảng kích cỡ &amp; tồn kho</h2>
            <% if (uniqueSizes.length > 0) { %>
              <table class="size-table">
                <thead>
                  <tr><th scope="col">Kích cỡ</th><th scope="col">Tồn kho</th></tr>
                </thead>
                <tbody>
                  <% uniqueSizes.forEach(function (size) { %>
                    <tr>
                      <td><%= size %></td>
                      <td><%= stockBySize[size] || 0 %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } else { %>
              <p class="pdp-desc">Sản phẩm chưa có thông tin kích cỡ.</p>
            <% } %>
          </div>

          <div class="pdp-section">
            <h2 class="pdp-section-title">Đánh giá</h2>
            <div class="review-list">
              <div class="review-item">
                <div class="review-head">
                  <span class="review-author">Chưa có đánh giá</span>
                  <span>0/5</span>
                </div>
                <p class="review-text">Đánh giá sẽ hiển thị sau khi bạn mua và nhận sản phẩm.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if (related.length > 0) { %>
        <section class="pdp-related">
          <div class="section-head">
            <h2 class="section-title">Sản phẩm liên quan</h2>
          </div>
          <div class="product-grid">
            <% related.forEach(function (item) {
              var cardProduct = {
                name: item.name,
                slug: item.slug,
                image: (item.images && item.images[0]) || '/images/placeholder/product.svg',
                price: Number(item.basePrice) || 0,
                salePrice: null
              };
            %>
              <%- include('../partials/product-card', { product: cardProduct }) %>
            <% }) %>
          </div>
        </section>
      <% } %>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script type="application/json" id="variants-data" nonce="<%= cspNonce %>"><%- JSON.stringify(vs).replace(/</g, '\\u003c') %></script>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/product-detail.js"></script>
</body>
</html>
