<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <div data-flash data-type="info" hidden></div>
  <%
    var L = (locals && locals.locals) ? locals.locals : (locals || {});
    var categories = Array.isArray(L.categories) ? L.categories : [];
    var colorOptions = Array.isArray(L.colors) ? L.colors : ['Đen', 'Trắng', 'Xanh', 'Đỏ', 'Xanh dương', 'Hồng', 'Tím', 'Nâu'];
  %>
  <main id="main-content" class="main-content admin-form-page">
    <div class="container page-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/admin">Quản trị</a>
        <span class="sep">/</span>
        <span aria-current="page">Thêm sản phẩm</span>
      </nav>

      <div class="page-head">
        <div>
          <h1 class="page-title">Thêm sản phẩm</h1>
          <p class="page-sub">Nhập thông tin sản phẩm và các biến thể Size/Màu</p>
        </div>
        <a href="/admin" class="page-back">Quay lại quản trị</a>
      </div>

      <form id="pForm" class="admin-form-card" data-api="json" autocomplete="off">
        <div class="admin-form-grid two">
          <div class="field span-two">
            <label class="label" for="p-name">Tên sản phẩm</label>
            <input type="text" id="p-name" name="name" class="input" maxlength="120" required placeholder="Ví dụ: Áo sơ mi linen">
            <small class="field-error-msg"></small>
          </div>

          <div class="field">
            <label class="label" for="p-category">Danh mục</label>
            <select id="p-category" name="category" class="select" required>
              <option value="">-- Chọn danh mục --</option>
              <% categories.forEach(function (cat) { %>
                <option value="<%= String(cat._id) %>"><%= cat.name %></option>
              <% }) %>
            </select>
            <small class="field-error-msg"></small>
          </div>

          <div class="field">
            <label class="label" for="p-material">Chất liệu</label>
            <input type="text" id="p-material" name="material" class="input" maxlength="120" placeholder="Cotton, linen, kaki...">
          </div>

          <div class="field">
            <label class="label" for="price">Giá bán</label>
            <input type="text" id="price" name="basePrice" class="input" inputmode="numeric" data-integer required placeholder="0">
            <small class="field-error-msg"></small>
          </div>

          <div class="field span-two">
            <label class="label" for="p-desc">Mô tả</label>
            <textarea id="p-desc" name="description" class="textarea" rows="4" maxlength="2000" placeholder="Mô tả chất liệu, form dáng, cách bảo quản..."></textarea>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-head">
            <h2 class="form-section-title">Biến thể sản phẩm</h2>
            <span class="form-section-note">Mỗi dòng là một cặp Size/Màu duy nhất</span>
          </div>

          <div id="variant-rows" class="variant-rows">
            <template id="variant-row-tpl">
              <div class="variant-row">
                <div class="variant-field">
                  <label>Màu sắc</label>
                  <select class="select" data-field="color">
                    <option value="">-- Màu --</option>
                    <% colorOptions.forEach(function (color) { %>
                      <option value="<%= color %>"><%= color %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="variant-field">
                  <label>Kích cỡ</label>
                  <input type="text" class="input" data-field="size" placeholder="M" maxlength="10">
                </div>
                <div class="variant-field">
                  <label>SKU</label>
                  <input type="text" class="input" data-field="sku" placeholder="SP-AO-001-M-DEN" maxlength="40">
                </div>
                <div class="variant-field">
                  <label>Giá</label>
                  <input type="text" class="input" data-field="price" data-integer inputmode="numeric" value="0" placeholder="0">
                </div>
                <div class="variant-field">
                  <label>Tồn kho</label>
                  <input type="text" class="input" data-field="stock" data-integer inputmode="numeric" value="0" placeholder="0">
                </div>
                <div class="variant-actions">
                  <button type="button" class="btn btn-danger btn-sm variant-remove" data-remove-variant>Xóa</button>
                </div>
                <p class="variant-error" aria-live="polite"></p>
              </div>
            </template>

            <div class="variant-row">
              <div class="variant-field">
                <label>Màu sắc</label>
                <select class="select" name="variants[0][color]" data-field="color">
                  <option value="">-- Màu --</option>
                  <% colorOptions.forEach(function (color) { %>
                    <option value="<%= color %>"><%= color %></option>
                  <% }) %>
                </select>
              </div>
              <div class="variant-field">
                <label>Kích cỡ</label>
                <input type="text" class="input" name="variants[0][size]" data-field="size" placeholder="M" maxlength="10">
              </div>
              <div class="variant-field">
                <label>SKU</label>
                <input type="text" class="input" name="variants[0][sku]" data-field="sku" placeholder="SP-AO-001-M-DEN" maxlength="40">
              </div>
              <div class="variant-field">
                <label>Giá</label>
                <input type="text" class="input" name="variants[0][price]" data-field="price" data-integer inputmode="numeric" value="0" placeholder="0">
              </div>
              <div class="variant-field">
                <label>Tồn kho</label>
                <input type="text" class="input" name="variants[0][stock]" data-field="stock" data-integer inputmode="numeric" value="0" placeholder="0">
              </div>
              <div class="variant-actions">
                <button type="button" class="btn btn-danger btn-sm variant-remove" data-remove-variant>Xóa</button>
              </div>
              <p class="variant-error" aria-live="polite"></p>
            </div>
          </div>

          <button type="button" id="addVariant" class="btn btn-soft">Thêm biến thể</button>
        </div>

        <div class="admin-form-actions">
          <button type="submit" class="btn btn-primary">Lưu sản phẩm</button>
          <a href="/admin" class="btn btn-ghost">Hủy</a>
        </div>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
