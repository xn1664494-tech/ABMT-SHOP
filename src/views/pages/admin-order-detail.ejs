<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/shop.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" media="all">
</head>
<body class="shop">
  <div data-flash data-type="info" hidden></div>
  <%
    var L = (locals && locals.locals) ? locals.locals : (locals || {});
    var active = L.active || 'orders';
    var order = L.order || {};
    var actions = order.actions || {};
    var pendingCount = Number(L.pendingCount) || 0;

    var adminUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : {};
    var adminName = adminUser.name || 'Quản trị viên';
    var adminInitial = String(adminName).trim().charAt(0).toUpperCase() || 'A';
  %>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="i-order" viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z"/><path d="M9 8h6M9 12h6"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-store" viewBox="0 0 24 24"><path d="M4 9l1.5-5h13L20 9"/><path d="M4 9a2.7 2.7 0 005.3 0 2.7 2.7 0 005.4 0A2.7 2.7 0 0020 9"/><path d="M5 12v8h14v-8"/></symbol>
    <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5"/><circle cx="17.5" cy="9" r="2.6"/><path d="M17 14.5c2.6.2 4.2 1.9 4.6 4.5"/></symbol>
    <symbol id="i-dash" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-out" viewBox="0 0 24 24"><path d="M10 4H6a2 2 0 00-2 2v12a2 2 0 002 2h4"/><path d="M16 8l4 4-4 4M20 12H9"/></symbol>
    <symbol id="i-chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol>
  </svg>

  <aside class="adm-sb" id="sb" aria-label="Menu quản trị">
    <div class="adm-brand">
      ABMT<small>Admin</small>
      <button type="button" class="adm-sb-close" data-adm-close aria-label="Đóng menu">×</button>
    </div>
    <nav class="adm-nav">
      <h2 class="adm-nav-h">Tổng quan</h2>
      <a href="/admin"><svg class="ico"><use href="#i-dash"/></svg>Tổng quan</a>
      <h2 class="adm-nav-h">Cửa hàng</h2>
      <a href="/admin/products/new"><svg class="ico"><use href="#i-plus"/></svg>Thêm sản phẩm</a>
      <a href="/admin/orders" aria-current="page"><svg class="ico"><use href="#i-order"/></svg>Đơn hàng<% if (pendingCount > 0) { %><span class="adm-cnt"><%= pendingCount %></span><% } %></a>
      <a href="/catalog"><svg class="ico"><use href="#i-store"/></svg>Xem cửa hàng</a>
      <h2 class="adm-nav-h">Tài khoản</h2>
      <a href="/admin/users"><svg class="ico"><use href="#i-users"/></svg>Người dùng</a>
      <a href="/account"><svg class="ico"><use href="#i-users"/></svg>Tài khoản</a>
    </nav>
    <div class="adm-who">
      Đăng nhập với tư cách
      <b><%= adminName %></b>
      <button type="button" class="adm-logout" data-adm-logout><svg class="ico" style="width:16px;height:16px"><use href="#i-out"/></svg>Đăng xuất</button>
    </div>
  </aside>
  <div class="adm-scrim" id="scrim"></div>

  <div class="adm-main">
    <header class="adm-top">
      <button type="button" id="tg" class="adm-tg" aria-label="Mở menu quản trị" aria-controls="sb" aria-expanded="false"><svg class="ico"><use href="#i-menu"/></svg></button>
      <div class="adm-sp"></div>
      <a class="adm-store" href="/catalog"><svg class="ico" style="width:18px;height:18px"><use href="#i-store"/></svg><span>Xem cửa hàng</span></a>
      <div class="adm-user"><span class="adm-av"><%= adminInitial %></span><span class="adm-nm"><%= adminName %></span><svg class="ico"><use href="#i-chev"/></svg></div>
    </header>

    <main class="adm-wrap" data-order-code="<%= order.code %>">
      <div class="adm-ph">
        <div>
          <p class="adm-crumb">Quản trị / Đơn hàng / <%= order.code %></p>
          <h1>Đơn hàng <%= order.code %></h1>
          <p class="adm-subtext">Đặt lúc <%= order.createdAtLabel %> · Cập nhật <%= order.updatedAtLabel %></p>
        </div>
        <div class="adm-row-actions">
          <span class="badge <%= order.statusClass %>" data-status-label="<%= order.status %>"><%= order.statusLabel %></span>
          <a class="adm-btn adm-btn--outline" href="/admin/orders">Danh sách đơn</a>
        </div>
      </div>

      <section class="adm-pn" aria-labelledby="h-actions">
        <header><h3 id="h-actions">Hành động quản trị</h3><span class="adm-hint">Chỉ thao tác hợp lệ với trạng thái hiện tại</span></header>
        <div class="adm-bd">
          <div class="adm-row-actions adm-actions-wrap">
            <% if (actions.confirm) { %>
              <button type="button" class="adm-btn" data-action="confirm-order" data-order-code="<%= order.code %>">Xác nhận đơn</button>
            <% } %>
            <% if (actions.ship) { %>
              <button type="button" class="adm-btn" data-action="ship-order" data-order-code="<%= order.code %>">Bàn giao vận chuyển</button>
            <% } %>
            <% if (actions.cancel) { %>
              <button type="button" class="adm-btn adm-btn--danger" data-action="cancel-order" data-order-code="<%= order.code %>" data-order-id="<%= order.id %>">Hủy đơn</button>
            <% } %>
            <% if (actions.markPaid) { %>
              <button type="button" class="adm-btn" data-action="mark-paid" data-order-code="<%= order.code %>">Đánh dấu đã nhận tiền</button>
            <% } %>
            <% if (actions.simulateDelivery) { %>
              <button type="button" class="adm-btn adm-btn--outline" data-action="simulate-delivery" data-order-code="<%= order.code %>">Giả lập: vận chuyển đã giao</button>
            <% } %>
            <% if (!actions.confirm && !actions.ship && !actions.cancel && !actions.markPaid && !actions.simulateDelivery) { %>
              <p class="adm-empty-item">Không có thao tác nào cho trạng thái hiện tại.</p>
            <% } %>
          </div>
        </div>
      </section>

      <div class="adm-g3" style="margin-top:16px;">
        <section class="adm-pn" aria-labelledby="h-customer">
          <header><h3 id="h-customer">Khách hàng &amp; giao hàng</h3></header>
          <div class="adm-bd">
            <dl class="adm-dl">
              <dt>Khách hàng</dt><dd><%= order.customer.name %></dd>
              <dt>Email</dt><dd><%= order.customer.email || '-' %></dd>
              <dt>Điện thoại</dt><dd><%= order.customer.phone %></dd>
              <dt>Người nhận</dt><dd><%= order.shipping.fullName %></dd>
              <dt>Địa chỉ giao</dt><dd><%= order.shipping.address %></dd>
            </dl>
          </div>
        </section>

        <section class="adm-pn" aria-labelledby="h-payment">
          <header><h3 id="h-payment">Thanh toán</h3></header>
          <div class="adm-bd">
            <dl class="adm-dl">
              <dt>Phương thức</dt><dd><%= order.paymentMethodLabel %></dd>
              <dt>Trạng thái</dt><dd><%= order.paymentStatusLabel %></dd>
              <dt>Tạm tính</dt><dd><%= order.subtotalLabel %></dd>
              <dt>Phí giao hàng</dt><dd><%= order.shippingFeeLabel %></dd>
              <dt>Giảm giá</dt><dd><%= order.discountLabel %></dd>
              <dt>Tổng tiền</dt><dd><b><%= order.totalLabel %></b></dd>
            </dl>
          </div>
        </section>
      </div>

      <section class="adm-pn" style="margin-top:16px;" aria-labelledby="h-items">
        <header><h3 id="h-items">Sản phẩm</h3><span class="adm-hint"><%= order.items.length %> mặt hàng</span></header>
        <% if (order.items.length > 0) { %>
          <div class="adm-tw" role="region" aria-label="Bảng sản phẩm đơn hàng" tabindex="0">
            <table class="adm-table">
              <thead><tr><th>Sản phẩm</th><th>Phân loại</th><th class="adm-r">Số lượng</th><th class="adm-r">Đơn giá</th><th class="adm-r">Thành tiền</th></tr></thead>
              <tbody>
                <% order.items.forEach(function (item) { %>
                  <tr>
                    <td>
                      <span class="adm-code"><%= item.name %></span>
                      <span class="adm-s2"><%= item.sku %></span>
                    </td>
                    <td><%= item.size %> / <%= item.color %></td>
                    <td class="adm-r"><%= item.qty %></td>
                    <td class="adm-r"><%= item.unitPriceLabel %></td>
                    <td class="adm-r"><%= item.lineTotalLabel %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="adm-empty-item">Đơn không có sản phẩm.</p>
        <% } %>
      </section>

      <div class="adm-g3" style="margin-top:16px;">
        <section class="adm-pn" aria-labelledby="h-ship">
          <header><h3 id="h-ship">Vận chuyển</h3></header>
          <div class="adm-bd">
            <dl class="adm-dl">
              <dt>Đơn vị</dt><dd><%= order.shipment.carrier || '-' %></dd>
              <dt>Mã vận đơn</dt><dd><%= order.shipment.trackingCode || '-' %></dd>
              <dt>Ngày giao hàng</dt><dd><%= order.shipment.shippedAtLabel || '-' %></dd>
              <dt>Ngày nhận hàng</dt><dd><%= order.shipment.deliveredAtLabel || '-' %></dd>
              <% if (order.cancel) { %>
                <dt>Lý do hủy</dt><dd><%= order.cancel.reason || '-' %> (<%= order.cancel.atLabel %>)</dd>
              <% } %>
            </dl>
            <% if (order.note) { %>
              <p class="adm-hint" style="margin-top:12px;">Ghi chú: <%= order.note %></p>
            <% } %>
          </div>
        </section>

        <section class="adm-pn" aria-labelledby="h-timeline">
          <header><h3 id="h-timeline">Lịch sử trạng thái</h3></header>
          <div class="adm-bd">
            <% if (order.statusHistory.length > 0) { %>
              <ol class="adm-timeline">
                <% order.statusHistory.forEach(function (entry) { %>
                  <li>
                    <span class="adm-timeline-status"><%= entry.statusLabel %></span>
                    <span class="adm-timeline-meta"><%= entry.atLabel %> · <b><%= entry.actorLabel %></b></span>
                    <% if (entry.note) { %><span class="adm-timeline-note"><%= entry.note %></span><% } %>
                  </li>
                <% }) %>
              </ol>
            <% } else { %>
              <p class="adm-empty-item">Chưa có lịch sử trạng thái.</p>
            <% } %>
          </div>
        </section>
      </div>
    </main>
  </div>

  <dialog id="order-dialog" class="adm-dialog" aria-labelledby="order-dialog-title">
    <form method="dialog" id="order-dialog-form">
      <header><h3 id="order-dialog-title">Xác nhận thao tác</h3></header>
      <div class="adm-dialog-body">
        <p id="order-dialog-message" class="adm-dialog-message"></p>
        <label class="adm-field" data-dialog-field="reason" hidden>
          <span class="adm-label">Lý do hủy</span>
          <input class="adm-input" name="reason" maxlength="500" placeholder="Nhập lý do hủy đơn">
        </label>
        <label class="adm-field" data-dialog-field="carrier" hidden>
          <span class="adm-label">Đơn vị vận chuyển</span>
          <input class="adm-input" name="carrier" maxlength="120" placeholder="VD: GHTK, GHN...">
        </label>
        <label class="adm-field" data-dialog-field="trackingCode" hidden>
          <span class="adm-label">Mã vận đơn</span>
          <input class="adm-input" name="trackingCode" maxlength="120" placeholder="Nhập mã vận đơn">
        </label>
        <p class="adm-dialog-error" data-dialog-error hidden></p>
      </div>
      <footer>
        <button type="button" class="adm-btn adm-btn--ghost" data-dialog-cancel>Hủy bỏ</button>
        <button type="button" class="adm-btn" data-dialog-confirm>Xác nhận</button>
      </footer>
    </form>
  </dialog>

  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/admin.js"></script>
  <script src="/js/admin-orders.js"></script>
</body>
</html>
