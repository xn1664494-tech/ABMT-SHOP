<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content" class="main-content">
    <div class="container">
      <div class="card-lg mx-auto my-8" style="max-width: 420px;">
        <h2 class="section-title text-center mb-6">Đăng nhập</h2>
        <form id="loginForm" class="pill-form" style="background: var(--surface); padding: 32px; border-radius: var(--r-md);">
          <div class="field">
            <label class="label" for="loginEmail">Email</label>
            <input type="email" name="email" class="input" id="loginEmail" autocomplete="username" required
              aria-invalid="false" aria-describedby="loginError">
          </div>
          <div class="field">
            <label class="label" for="loginPassword">Mật khẩu</label>
            <input type="password" name="password" class="input" id="loginPassword" autocomplete="current-password" required
              aria-invalid="false" aria-describedby="loginError">
            <button type="button" class="btn-soft" type="button" aria-label="Hiện mật khẩu" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); padding: 0; background: none; color: var(--muted);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="6" y1="2" x6="6" y2="22"/></svg>
            </button>
          </div>
          <% if (locals && locals.error) { %>
          <div id="loginError" class="field-error" role="alert" style="margin-top: 12px; color: var(--danger); font-size: 13px;"><%= locals.error %></div>
          <% } %>
          <input type="hidden" name="next" value="<%= locals && locals.next ? locals.next : '' %>">
          <button type="submit" class="btn btn-primary btn-block" style="width: 100%; margin-top: 24px;">Đăng nhập</button>
        </form>
        <div class="text-center mt-4" style="font-size: 13px; color: var(--muted);">
          <a href="/register" class="link-primary">Tạo tài khoản mới</a>
        </div>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/login.js"></script>
</body>
</html>