<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content" class="main-content">
    <section class="auth-page">
      <div class="auth-card">
        <h1 class="auth-title">Đăng nhập</h1>
        <form id="loginForm" class="auth-form" novalidate>
          <div class="field">
            <label class="label" for="loginEmail">Email</label>
            <input type="email" name="email" id="loginEmail" class="input" autocomplete="username" required aria-invalid="false" aria-describedby="loginEmailError">
            <p class="field-error" id="loginEmailError" hidden></p>
          </div>
          <div class="field">
            <label class="label" for="loginPassword">Mật khẩu</label>
            <div class="input-group">
              <input type="password" id="loginPassword" name="password" class="input" autocomplete="current-password" required aria-invalid="false" aria-describedby="loginPasswordError">
              <button type="button" class="input-toggle" data-toggle-password aria-label="Hiện mật khẩu" aria-pressed="false">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
            <p class="field-error" id="loginPasswordError" hidden></p>
          </div>
          <div id="loginError" role="alert"<% if (!locals || !locals.error) { %> hidden<% } %>>
            <% if (locals && locals.error) { %><%- locals.error %><% } %>
          </div>
          <input type="hidden" name="next" value="<%= locals && locals.next ? locals.next : '' %>">
          <button type="submit" class="btn btn-primary btn-block">Đăng nhập</button>
        </form>
        <p class="auth-switch">Chưa có tài khoản? <a href="/register">Tạo tài khoản mới</a></p>
      </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/password-toggle.js"></script>
  <script src="/js/login.js"></script>
</body>
</html>
