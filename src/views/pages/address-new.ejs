<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content" class="main-content">
    <div class="container">
      <section id="address-section" class="section" style="padding-bottom: 24px;">
        <div class="container">
          <div class="row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
            <!-- Thêm địa chỉ mới -->
            <div id="add-new-address" style="background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 16px;">
              <h3 style="font-size: 16px; font-weight: 600; color: var(--ink-strong); margin-bottom: 16px;">Thêm địa chỉ mới</h3>
              <form id="aForm" style="display: grid; gap: 12px;">
                <input type="text" name="name" class="input" placeholder="Họ và tên" required
                  style="<%= locals && locals.nameError ? 'border-color: var(--danger);' : '' %>"
                  aria-invalid="<%= !!locals && locals.nameError %>" aria-describedby="name-help">
                <small id="name-help" style="color: var(--muted); font-size: 12%;">Họ và tên không rỗng</small>

                <select name="province" class="select" required
                  style="<%= locals && locals.provinceError ? 'border-color: var(--danger);' : '' %>"
                  aria-invalid="<%= !!locals && locals.provinceError %>">
                  <option value="">-- Chọn Tỉnh/Thành --</option>
                  <% if (locals && locals && provinces) { %>
                  <% provinces.forEach(function(prov) { %>
                    <option value="<%= prov.code %>" <%= (locals.selectedProvince === prov.code ? 'selected' : '') %>><%= prov.name %></option>
                  <% }) %>
                  <% } %>
                </select>

                <select name="district" class="select" aria-label="Quận/Huyện"
                  style="<%= locals && locals.districtError ? 'border-color: var(--danger);' : '' %>"
                  aria-invalid="<%= !!locals && locals.districtError %>">
                  <option value="">-- Chọn Quận/Huyện --</option>
                </select>

                <select name="ward" class="select" aria-label="Phường/Xã"
                  style="<%= locals && locals.wardError ? 'border-color: var(--danger);' : '' %>"
                  aria-invalid="<%= !!locals && locals.wardError %>">
                  <option value="">-- Chọn Phường/Xã --</option>
                </select>

                <input type="text" name="street" class="input" placeholder="Địa chỉ cụ thể" required
                  style="<%= locals && locals.streetError ? 'border-color: var(--danger);' : '' %>"
                  aria-invalid="<%= !!locals && locals.streetError %>" aria-describedby="street-help">
                <small id="street-help" style="color: var(--muted); font-size: 12%;">Địa chỉ cụ thể không rỗng</small>

                <% if (locals && locals.maxed) { %>
                <div style="color: var(--danger); font-size: 12px; margin-top: -12px;">Bạn đã đạt giới hạn số địa chỉ có thể lưu</div>
                <% } %>
              </form>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/address.js"></script>
  <script src="/js/checkout.js"></script>
</body>
</html>