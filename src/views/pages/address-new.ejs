<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <div data-flash data-type="info" hidden></div>
  <%
    var L = (locals && locals.locals) ? locals.locals : (locals || {});
    var provinces = Array.isArray(L.provinces) ? L.provinces : [];
  %>
  <main id="main-content" class="main-content address-page">
    <div class="container page-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/account">Tài khoản</a>
        <span class="sep">/</span>
        <span aria-current="page">Thêm địa chỉ</span>
      </nav>

      <div class="page-head">
        <div>
          <h1 class="page-title">Thêm địa chỉ mới</h1>
          <p class="page-sub">Địa chỉ này sẽ được dùng khi bạn thanh toán</p>
        </div>
        <a href="/account" class="page-back">Quay lại tài khoản</a>
      </div>

      <div id="maxed" class="limit-note" hidden>Bạn đã đạt giới hạn 3 địa chỉ. Vui lòng xóa bớt địa chỉ cũ trước khi thêm mới.</div>

      <form id="aForm" class="form-card" novalidate>
        <div class="form-grid two">
          <div class="field">
            <label class="label" for="ad-name">Họ và tên</label>
            <input type="text" id="ad-name" name="name" class="input" autocomplete="name" placeholder="Nguyễn Văn A">
            <small class="field-error-msg"></small>
          </div>
          <div class="field">
            <label class="label" for="ad-phone">Số điện thoại</label>
            <input type="tel" id="ad-phone" name="phone" class="input" autocomplete="tel" placeholder="0901234567">
            <small class="field-error-msg"></small>
          </div>
          <div class="field">
            <label class="label" for="ad-province">Tỉnh/Thành</label>
            <select id="ad-province" name="province" class="select">
              <option value="">-- Chọn Tỉnh/Thành --</option>
              <% provinces.forEach(function (province) { %>
                <option value="<%= province.code %>"><%= province.name %></option>
              <% }) %>
            </select>
            <small class="field-error-msg"></small>
          </div>
          <div class="field">
            <label class="label" for="ad-district">Quận/Huyện</label>
            <select id="ad-district" name="district" class="select" disabled>
              <option value="">-- Chọn Quận/Huyện --</option>
            </select>
          </div>
          <div class="field">
            <label class="label" for="ad-ward">Phường/Xã</label>
            <select id="ad-ward" name="ward" class="select" disabled>
              <option value="">-- Chọn Phường/Xã --</option>
            </select>
            <small class="field-error-msg"></small>
          </div>
          <div class="field">
            <label class="label" for="ad-street">Địa chỉ cụ thể</label>
            <input type="text" id="ad-street" name="street" class="input" autocomplete="street-address" placeholder="Số nhà, tên đường">
            <small class="field-error-msg"></small>
          </div>
        </div>

        <div class="field check-row">
          <label class="check">
            <input type="checkbox" name="isDefault" value="1">
            <span>Đặt làm địa chỉ mặc định</span>
          </label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Lưu địa chỉ</button>
          <a href="/account" class="btn btn-ghost">Hủy</a>
        </div>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/address.js"></script>
</body>
</html>
