<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <%- include('../partials/flash') %>
  <main id="main-content" class="main-content">
    <!-- Banner -->
    <section id="home-banner" class="section banner-section">
      <div class="container">
        <div class="hero">
          <div class="banner-slider" id="banner-slider" role="region" aria-roledescription="carousel" aria-label="Banner nổi bật">
            <div class="banner-slide is-active" role="group" aria-roledescription="slide" aria-label="1 / 3">
              <img src="/images/placeholder/banner-1.svg" alt="Bộ sưu tập mới ABMT SHOP" class="banner-image">
              <div class="banner-content">
                <p class="banner-eyebrow">Bộ sưu tập Thu Đông</p>
                <h1 class="banner-title">Mặc đẹp mỗi ngày, thoải mái từ sáng đến tối</h1>
                <p class="banner-desc">Thiết kế gọn gàng, dễ phối cho đi học, đi làm và đi chơi.</p>
                <div class="banner-ctas">
                  <a href="#section-new-men" class="btn btn-primary">Mua ngay</a>
                  <a href="/catalog" class="btn btn-ghost">Xem tất cả</a>
                </div>
              </div>
            </div>
            <div class="banner-slide" role="group" aria-roledescription="slide" aria-label="2 / 3">
              <img src="/images/placeholder/banner-2.svg" alt="Ưu đãi mùa mới" class="banner-image">
              <div class="banner-content">
                <p class="banner-eyebrow">Ưu đãi đặc biệt</p>
                <h2 class="banner-title">Giảm giá lên đến 30%</h2>
                <p class="banner-desc">Những mẫu được yêu thích đang có giá tốt, số lượng có hạn theo từng size.</p>
                <a href="#section-sale" class="btn btn-primary">Mua ngay</a>
              </div>
            </div>
            <div class="banner-slide" role="group" aria-roledescription="slide" aria-label="3 / 3">
              <img src="/images/placeholder/banner.svg" alt="Gọn gàng cho ngày làm việc" class="banner-image">
              <div class="banner-content">
                <p class="banner-eyebrow">Gọn gàng đi làm</p>
                <h2 class="banner-title">Áo sơ mi và quần dài cho ngày làm việc</h2>
                <p class="banner-desc">Chất liệu thoáng, ít nhăn, mặc thoải mái cả ngày dài.</p>
                <a href="#section-new-men" class="btn btn-primary">Khám phá</a>
              </div>
            </div>
            <button type="button" class="banner-arrow banner-arrow--prev" aria-label="Banner trước">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
            <button type="button" class="banner-arrow banner-arrow--next" aria-label="Banner sau">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
            </button>
            <div class="banner-dots" id="banner-dots" aria-label="Chuyển banner">
              <button class="banner-dot is-active" type="button" data-slide="0" aria-label="Banner 1"></button>
              <button class="banner-dot" type="button" data-slide="1" aria-label="Banner 2"></button>
              <button class="banner-dot" type="button" data-slide="2" aria-label="Banner 3"></button>
            </div>
          </div>
          <div class="hero-side">
            <a class="hero-promo hero-promo--lilac" href="#section-new-men">
              <svg class="hero-promo-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/></svg>
              <b>Sản phẩm mới</b>
              <span>Vừa lên kệ, xem ngay</span>
            </a>
            <a class="hero-promo hero-promo--sand" href="/catalog">
              <svg class="hero-promo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg>
              <b>Miễn phí giao hàng</b>
              <span>Cho đơn từ 500.000₫</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <%
      const menCategory = categories.find(function (cat) { return cat.name === 'Nam'; });
      const womenCategory = categories.find(function (cat) { return cat.name === 'Nữ'; });
    %>

    <!-- Lối tắt -->
    <section id="section-shortcuts" class="section shortcuts-section" aria-label="Lối tắt">
      <div class="container">
        <div class="shortcuts-grid">
          <a href="/catalog?sort=newest" class="shortcut-card">
            <span class="shortcut-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/>
              </svg>
            </span>
            <span class="shortcut-text"><strong>Sản phẩm mới</strong><span>Vừa lên kệ</span></span>
          </a>
          <a href="#section-sale" class="shortcut-card">
            <span class="shortcut-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12V4h8l10 10-8 8L3 12z"/>
                <circle cx="7.5" cy="7.5" r="1"/>
              </svg>
            </span>
            <span class="shortcut-text"><strong>Giảm giá</strong><span>Giá tốt hôm nay</span></span>
          </a>
          <a href="#section-bestseller" class="shortcut-card">
            <span class="shortcut-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2.8l2.8 5.8 6.4.9-4.6 4.5 1.1 6.3L12 17.2l-5.7 3.1 1.1-6.3L2.8 9.5l6.4-.9z"/>
              </svg>
            </span>
            <span class="shortcut-text"><strong>Bán chạy</strong><span>Được chọn nhiều</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- Mã giảm giá -->
    <% if (vouchers.length > 0) { %>
      <section id="section-vouchers" class="section vouchers-section">
        <div class="container">
          <div class="section-head">
            <h2 class="section-title">Mã giảm giá</h2>
            <p class="section-note">Sao chép mã rồi dán ở trang thanh toán</p>
          </div>
          <div class="voucher-grid">
            <% vouchers.forEach(function (v) { %>
              <article class="voucher-card">
                <span class="voucher-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.5" cy="7.5" r="1"/></svg>
                </span>
                <p class="voucher-code"><%= v.code %></p>
                <p class="voucher-desc"><%= v.desc %></p>
                <p class="voucher-note"><%= v.note %></p>
                <button type="button" class="voucher-copy" data-code="<%= v.code %>">Sao chép mã</button>
              </article>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Mua theo danh mục -->
    <% if (categories.length > 0) { %>
      <section id="section-categories" class="section categories-section" aria-labelledby="h-cat">
        <div class="container">
          <div class="section-head"><h2 class="section-title" id="h-cat">Mua theo danh mục</h2></div>
          <div class="category-grid">
            <% categories.forEach(function(cat){ %>
              <div class="category-card" id="cat-<%= cat.slug %>">
                <svg class="category-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 3L3 6l2 4 3-1V21h8V9l3 1 2-4-6-3-3 4-3-4z"/></svg>
                <a class="category-link" href="<%= cat.url %>">
                  <b class="category-name"><%= cat.name %></b>
                  <span class="category-note"><%= cat.note %></span>
                </a>
                <% if (cat.children && cat.children.length) { %>
                  <div class="category-chips">
                    <% cat.children.slice(0, 6).forEach(function(child){ %>
                      <a href="<%= child.url %>"><%= child.name %></a>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Sản phẩm mới cho nam -->
    <% if (productsNewMen.length > 0) { %>
      <section id="section-new-men" class="section products-section">
        <div class="container">
          <div class="section-head">
            <h2 class="section-title">Sản phẩm mới cho nam</h2>
            <a href="<%= menCategory ? '/catalog?category=' + encodeURIComponent(menCategory.slug) + '&sort=newest' : '/catalog?sort=newest' %>" class="section-link">Xem tất cả ›</a>
          </div>
          <div class="product-grid">
            <% productsNewMen.forEach(function (product) { %>
              <%- include('../partials/product-card', { product: product, badge: 'Mới' }) %>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Sản phẩm mới cho nữ -->
    <% if (productsNewWomen.length > 0) { %>
      <section id="section-new-women" class="section products-section">
        <div class="container">
          <div class="section-head">
            <h2 class="section-title">Sản phẩm mới cho nữ</h2>
            <a href="<%= womenCategory ? '/catalog?category=' + encodeURIComponent(womenCategory.slug) + '&sort=newest' : '/catalog?sort=newest' %>" class="section-link">Xem tất cả ›</a>
          </div>
          <div class="product-grid">
            <% productsNewWomen.forEach(function (product) { %>
              <%- include('../partials/product-card', { product: product, badge: 'Mới' }) %>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Đang giảm giá -->
    <% if (productsSale.length > 0) { %>
      <section id="section-sale" class="section products-section">
        <div class="container">
          <div class="sale-box">
            <div class="section-head">
              <div class="sale-head-main">
                <h2 class="section-title">
                  <svg class="sale-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="7.5" cy="7.5" r="1"/></svg>
                  Đang giảm giá
                </h2>
                <p class="section-note">Những mẫu được yêu thích với mức giá tốt</p>
              </div>
              <a href="/catalog" class="section-link">Xem tất cả ›</a>
            </div>
            <div class="carousel" data-carousel>
              <button type="button" class="carousel-arrow carousel-arrow--prev" aria-label="Xem trước" data-carousel-prev>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 5l-7 7 7 7"/>
                </svg>
              </button>
              <div class="carousel-track" id="carousel-sale">
                <% productsSale.forEach(function (product) { %>
                  <%- include('../partials/product-card', { product: product, badge: 'Giảm giá' }) %>
                <% }) %>
              </div>
              <button type="button" class="carousel-arrow carousel-arrow--next" aria-label="Xem tiếp" data-carousel-next>
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Bán chạy -->
    <% if (productsBestSeller.length > 0) { %>
      <section id="section-bestseller" class="section products-section">
        <div class="container">
          <div class="section-head">
            <h2 class="section-title">Bán chạy</h2>
            <a href="/catalog" class="section-link">Xem tất cả ›</a>
          </div>
          <div class="carousel" data-carousel>
            <button type="button" class="carousel-arrow carousel-arrow--prev" aria-label="Xem trước" data-carousel-prev>
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 5l-7 7 7 7"/>
              </svg>
            </button>
            <div class="carousel-track" id="carousel-bestseller">
              <% productsBestSeller.forEach(function (product, index) { %>
                <%- include('../partials/product-card', { product: product, rank: index + 1 }) %>
              <% }) %>
            </div>
            <button type="button" class="carousel-arrow carousel-arrow--next" aria-label="Xem tiếp" data-carousel-next>
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </div>
      </section>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/home.js"></script>
</body>
</html>
