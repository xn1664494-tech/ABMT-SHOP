<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/shop.css">
</head>
<body class="shop">
  <%- include('../partials/header') %>
  <div data-flash data-type="info" hidden></div>
  <%
    var L = (locals && locals.locals) ? locals.locals : (locals || {});
    var order = L.order || {};
    var items = Array.isArray(order.items) ? order.items : [];
    var shipping = order.shipping || {};
    var history = Array.isArray(order.statusHistory) ? order.statusHistory.slice() : [];
    history.sort(function (a, b) {
      return (new Date((a && a.at) || 0).getTime() || 0) - (new Date((b && b.at) || 0).getTime() || 0);
    });
    if (history.length === 0) {
      history = [{
        status: order.status,
        statusLabel: order.statusLabel,
        at: order.createdAt,
        atLabel: order.createdAtLabel,
        note: ''
      }];
    }

    function hasImage(url) {
      return typeof url === 'string' && /^(\/|https?:\/\/)/i.test(url);
    }
  %>
  <main id="main-content" class="main-content">
    <div class="wrap page-shell">
      <nav class="bc" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/account?tab=orders">Đơn hàng</a>
        <span class="sep">/</span>
        <span aria-current="page"><%= order.code || 'Chi tiết đơn hàng' %></span>
      </nav>

      <div class="acc-detail-head">
        <div>
          <h1 class="acc-detail-code">Đơn hàng <%= order.code || '—' %></h1>
          <p class="acc-detail-date">Ngày đặt: <%= order.createdAtLabel || '—' %></p>
        </div>
        <span class="badge <%= order.statusClass %>" data-status-label="<%= order.status %>"><%= order.statusLabel %></span>
      </div>

      <div class="acc-detail-grid">
        <div class="acc-detail-col">
          <section class="acc-panel" aria-labelledby="acc-timeline-title">
            <div class="acc-panel-head">
              <h2 class="acc-panel-title" id="acc-timeline-title">Trạng thái đơn hàng</h2>
            </div>
            <ol class="acc-timeline">
              <% history.forEach(function (entry, index) { %>
                <li class="acc-timeline-item<%= index === history.length - 1 ? ' is-current' : '' %>">
                  <span class="acc-timeline-dot" aria-hidden="true"></span>
                  <div>
                    <p class="acc-timeline-status" data-history-status="<%= entry.status %>"><%= entry.statusLabel %></p>
                    <p class="acc-timeline-date"><%= entry.atLabel %></p>
                    <% if (entry.note) { %>
                      <p class="acc-timeline-note"><%= entry.note %></p>
                    <% } %>
                  </div>
                </li>
              <% }) %>
            </ol>
          </section>

          <section class="acc-panel" aria-labelledby="acc-items-title">
            <div class="acc-panel-head">
              <h2 class="acc-panel-title" id="acc-items-title">Sản phẩm</h2>
              <span class="acc-panel-link"><%= items.length %> sản phẩm</span>
            </div>
            <div class="acc-detail-items">
              <% items.forEach(function (item) { %>
                <div class="acc-detail-item">
                  <span class="acc-thumb">
                    <% if (hasImage(item.image)) { %>
                      <img src="<%= item.image %>" alt="<%= item.name || 'Sản phẩm' %>" loading="lazy" decoding="async">
                    <% } else { %>
                      <span class="acc-thumb-fallback" aria-hidden="true"><%= String(item.name || '?').trim().charAt(0).toUpperCase() || '?' %></span>
                    <% } %>
                  </span>
                  <div class="acc-detail-item-main">
                    <p class="acc-detail-item-name"><%= item.name || 'Sản phẩm' %></p>
                    <p class="acc-detail-item-meta">
                      <% if (item.color) { %><span>Màu: <%= item.color %></span><% } %>
                      <% if (item.size) { %><span> · Size: <%= item.size %></span><% } %>
                      <% if (item.sku) { %><span> · SKU: <%= item.sku %></span><% } %>
                    </p>
                    <p class="acc-detail-item-price">
                      Đơn giá: <%= item.unitPriceLabel %> × <%= item.qty %>
                    </p>
                  </div>
                  <p class="acc-detail-item-total"><%= item.lineTotalLabel %></p>
                </div>
              <% }) %>
            </div>
          </section>
        </div>

        <div class="acc-detail-col">
          <section class="acc-panel" aria-labelledby="acc-shipping-title">
            <div class="acc-panel-head">
              <h2 class="acc-panel-title" id="acc-shipping-title">Địa chỉ giao hàng</h2>
            </div>
            <div class="acc-info-list">
              <div class="acc-info-row">
                <span class="acc-info-label">Người nhận</span>
                <span class="acc-info-value"><strong><%= shipping.fullName || '—' %></strong></span>
              </div>
              <div class="acc-info-row">
                <span class="acc-info-label">Số điện thoại</span>
                <span class="acc-info-value"><%= shipping.phone || '—' %></span>
              </div>
              <div class="acc-info-row">
                <span class="acc-info-label">Địa chỉ</span>
                <span class="acc-info-value"><%= shipping.address || '—' %></span>
              </div>
            </div>
          </section>

          <section class="acc-panel" aria-labelledby="acc-payment-title">
            <div class="acc-panel-head">
              <h2 class="acc-panel-title" id="acc-payment-title">Thanh toán</h2>
              <span class="badge badge-soft"><%= order.paymentStatusLabel %></span>
            </div>
            <div class="acc-info-list">
              <div class="acc-info-row">
                <span class="acc-info-label">Phương thức</span>
                <span class="acc-info-value"><%= order.paymentMethodLabel %></span>
              </div>
              <div class="acc-info-row">
                <span class="acc-info-label">Trạng thái</span>
                <span class="acc-info-value"><%= order.paymentStatusLabel %></span>
              </div>
            </div>
          </section>

          <section class="acc-panel" aria-labelledby="acc-summary-title">
            <div class="acc-panel-head">
              <h2 class="acc-panel-title" id="acc-summary-title">Tóm tắt</h2>
            </div>
            <dl class="acc-summary">
              <div class="acc-summary-row">
                <dt>Tạm tính</dt>
                <dd><%= order.subtotalLabel %></dd>
              </div>
              <div class="acc-summary-row">
                <dt>Phí vận chuyển</dt>
                <dd><%= order.shippingFeeLabel %></dd>
              </div>
              <div class="acc-summary-row">
                <dt>Giảm giá</dt>
                <dd><%= order.discount > 0 ? '-' + order.discountLabel : order.discountLabel %></dd>
              </div>
              <div class="acc-summary-row is-total">
                <dt>Tổng cộng</dt>
                <dd><%= order.totalLabel %></dd>
              </div>
            </dl>
          </section>
        </div>
      </div>

      <div class="acc-detail-actions">
        <% if (order.canCancel) { %>
          <button type="button" class="btn btn-danger" data-action="cancel-order" data-order-id="<%= order.id %>">Hủy đơn hàng</button>
        <% } %>
        <a class="btn btn-ghost" href="/account?tab=orders">Quay lại danh sách</a>
        <a class="btn btn-primary" href="/catalog">Tiếp tục mua sắm</a>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/orders.js"></script>
</body>
</html>
