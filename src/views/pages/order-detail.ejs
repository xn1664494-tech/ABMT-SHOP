<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <style>
    .order-detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; align-items: start; }
    .order-detail-card { margin-bottom: 20px; }
    .order-detail-card > h2 { font-size: 16px; margin: 0 0 14px; color: var(--ink-strong); }
    .order-detail-row { display: grid; grid-template-columns: 140px 1fr; gap: 8px 16px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
    .order-detail-row:last-child { border-bottom: none; }
    .order-detail-label { color: var(--muted); }
    .order-detail-value { color: var(--ink); }
    .order-detail-item { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
    .order-detail-item:last-child { border-bottom: none; }
    .order-detail-item img { width: 56px; height: 56px; object-fit: cover; border-radius: var(--r-sm); border: 1px solid var(--line); }
    .order-detail-item-body { flex: 1; min-width: 0; }
    .order-detail-item-name { font-size: 14px; font-weight: 600; color: var(--ink-strong); margin: 0 0 4px; }
    .order-detail-item-meta { font-size: 12px; color: var(--muted); margin: 0 0 6px; }
    .order-detail-item-price { font-size: 13px; color: var(--ink); }
    .order-detail-total { display: flex; justify-content: space-between; padding: 6px 0; font-size: 13px; }
    .order-detail-total strong { color: var(--ink-strong); font-size: 15px; }
    .order-history { margin: 0; padding: 0 0 0 18px; list-style: none; }
    .order-history li { position: relative; padding: 0 0 14px 14px; border-left: 1px solid var(--line); font-size: 13px; }
    .order-history li:last-child { border-left-color: transparent; padding-bottom: 0; }
    .order-history li::before { content: ''; position: absolute; left: -5px; top: 4px; width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
    .order-history-note { color: var(--muted); font-size: 12px; margin: 4px 0 0; }
    @media (max-width: 991.98px) { .order-detail-grid { grid-template-columns: 1fr; } }
    @media (max-width: 575.98px) { .order-detail-row { grid-template-columns: 1fr; gap: 2px; } }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <%- include('../partials/flash') %>
  <%
    const L = (locals && locals.locals) ? locals.locals : (locals || {});
    const order = L.order || {};
    const items = Array.isArray(order.items) ? order.items : [];
    const history = Array.isArray(order.statusHistory) ? order.statusHistory : [];
  %>
  <main id="main-content" class="main-content">
    <div class="container page-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/orders">Đơn hàng của tôi</a>
        <span class="sep">/</span>
        <span aria-current="page">Chi tiết đơn hàng</span>
      </nav>

      <div class="page-head">
        <div>
          <h1 class="page-title">Chi tiết đơn hàng</h1>
          <p class="page-sub"><%= order.code %></p>
        </div>
        <a href="/orders" class="btn btn-ghost btn-sm">Quay lại danh sách</a>
      </div>

      <div class="order-detail-grid">
        <div>
          <section class="card order-detail-card" aria-labelledby="order-status-heading">
            <h2 id="order-status-heading">Trạng thái đơn hàng</h2>
            <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
              <span class="badge <%= order.statusClass %>" data-status-label="<%= order.status %>"><%= order.statusLabel %></span>
              <span style="font-size: 13px; color: var(--muted);">Cập nhật lúc <%= order.updatedAtLabel %></span>
            </div>
            <% if (order.canCancel) { %>
              <p style="margin: 14px 0 0;">
                <button type="button" class="btn btn-danger btn-sm" data-action="cancel-order" data-order-id="<%= order.id %>">Hủy đơn</button>
              </p>
            <% } %>
          </section>

          <section class="card order-detail-card" aria-labelledby="order-items-heading">
            <h2 id="order-items-heading">Sản phẩm</h2>
            <% items.forEach(function (item) { %>
              <div class="order-detail-item">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="" loading="lazy">
                <% } %>
                <div class="order-detail-item-body">
                  <p class="order-detail-item-name"><%= item.name %></p>
                  <p class="order-detail-item-meta">SKU: <%= item.sku %> · Size: <%= item.size %> · Màu: <%= item.color %></p>
                  <p class="order-detail-item-price"><%= item.qty %> × <%= item.unitPriceLabel %> = <%= item.lineTotalLabel %></p>
                </div>
              </div>
            <% }) %>
          </section>

          <section class="card order-detail-card" aria-labelledby="order-history-heading">
            <h2 id="order-history-heading">Lịch sử trạng thái</h2>
            <ul class="order-history">
              <% history.forEach(function (entry) { %>
                <li data-history-status="<%= entry.status %>">
                  <strong><%= entry.statusLabel %></strong>
                  <span style="color: var(--muted);">— <%= entry.atLabel %></span>
                  <% if (entry.note) { %><p class="order-history-note"><%= entry.note %></p><% } %>
                </li>
              <% }) %>
            </ul>
          </section>
        </div>

        <div>
          <section class="card order-detail-card" aria-labelledby="order-info-heading">
            <h2 id="order-info-heading">Thông tin đơn hàng</h2>
            <div class="order-detail-row"><span class="order-detail-label">Mã đơn</span><span class="order-detail-value"><%= order.code %></span></div>
            <div class="order-detail-row"><span class="order-detail-label">Ngày đặt</span><span class="order-detail-value"><%= order.createdAtLabel %></span></div>
            <div class="order-detail-row"><span class="order-detail-label">Thanh toán</span><span class="order-detail-value"><%= order.paymentStatusLabel %></span></div>
            <div class="order-detail-row"><span class="order-detail-label">Phương thức</span><span class="order-detail-value"><%= order.paymentMethodLabel %></span></div>
          </section>

          <section class="card order-detail-card" aria-labelledby="order-shipping-heading">
            <h2 id="order-shipping-heading">Địa chỉ giao hàng</h2>
            <div class="order-detail-row"><span class="order-detail-label">Người nhận</span><span class="order-detail-value"><%= order.shipping.fullName %></span></div>
            <div class="order-detail-row"><span class="order-detail-label">Điện thoại</span><span class="order-detail-value"><%= order.shipping.phone %></span></div>
            <div class="order-detail-row"><span class="order-detail-label">Địa chỉ</span><span class="order-detail-value"><%= order.shipping.address %></span></div>
            <% if (order.note) { %>
              <div class="order-detail-row"><span class="order-detail-label">Ghi chú</span><span class="order-detail-value"><%= order.note %></span></div>
            <% } %>
          </section>

          <section class="card order-detail-card" aria-labelledby="order-total-heading">
            <h2 id="order-total-heading">Tổng tiền</h2>
            <div class="order-detail-total"><span>Tạm tính</span><span><%= order.subtotalLabel %></span></div>
            <div class="order-detail-total"><span>Phí vận chuyển</span><span><%= order.shippingFeeLabel %></span></div>
            <div class="order-detail-total"><span>Giảm giá</span><span><%= order.discountLabel %></span></div>
            <div class="order-detail-total" style="border-top: 1px solid var(--line); margin-top: 8px; padding-top: 12px;">
              <strong>Tổng cộng</strong><strong><%= order.totalLabel %></strong>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/orders.js"></script>
</body>
</html>
