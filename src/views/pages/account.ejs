<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/shop.css">
</head>
<body class="shop">
  <%- include('../partials/header') %>
  <div data-flash data-type="info" hidden></div>
  <%
    var L = (locals && locals.locals) ? locals.locals : (locals || {});
    var accountUser = L.user || {};
    var tab = L.tab || 'overview';
    var status = L.status || '';
    var q = L.q || '';
    var counts = L.counts || {};
    var totalOrders = Number(L.totalOrders) || 0;
    var processingCount = Number(L.processingCount) || 0;
    var orders = Array.isArray(L.orders) ? L.orders : [];
    var recentOrders = Array.isArray(L.recentOrders) ? L.recentOrders : [];
    var addresses = Array.isArray(L.addresses)
      ? L.addresses
      : (Array.isArray(accountUser.addresses) ? accountUser.addresses : []);
    var defaultAddress = L.defaultAddress || null;
    var pagination = L.pagination || null;

    var STATUS_LABELS = {
      pending: 'Chờ xử lý',
      confirmed: 'Đã xác nhận',
      shipping: 'Đang giao',
      delivered: 'Đã giao',
      cancelled: 'Đã hủy'
    };
    var STATUS_ORDER = ['pending', 'confirmed', 'shipping', 'delivered', 'cancelled'];
    var EMPTY_TITLES = {
      '': 'Bạn chưa có đơn hàng nào',
      pending: 'Không có đơn hàng chờ xử lý',
      confirmed: 'Không có đơn hàng đã xác nhận',
      shipping: 'Không có đơn hàng đang giao',
      delivered: 'Không có đơn hàng đã giao',
      cancelled: 'Không có đơn hàng đã hủy'
    };

    function money(value) {
      return (Number(value) || 0).toLocaleString('vi-VN') + 'đ';
    }
    function pad2(value) {
      return String(value).padStart(2, '0');
    }
    function fmtDate(value) {
      if (!value) return '—';
      var date = new Date(value);
      if (isNaN(date.getTime())) return '—';
      return pad2(date.getDate()) + '/' + pad2(date.getMonth() + 1) + '/' + date.getFullYear()
        + ' ' + pad2(date.getHours()) + ':' + pad2(date.getMinutes());
    }
    function statusLabel(value) {
      return STATUS_LABELS[value] || value || '—';
    }
    function statusClass(value) {
      return 'acc-badge acc-badge--' + (STATUS_LABELS[value] ? value : 'muted');
    }
    function hasImage(url) {
      return typeof url === 'string' && /^(\/|https?:\/\/)/i.test(url);
    }
    function addressFull(addr) {
      if (!addr) return '';
      return [addr.street, addr.ward, addr.district, addr.city].filter(Boolean).join(', ');
    }
    function qs(params) {
      return Object.keys(params).filter(function (key) {
        return params[key] !== undefined && params[key] !== null && String(params[key]) !== '';
      }).map(function (key) {
        return encodeURIComponent(key) + '=' + encodeURIComponent(String(params[key]));
      }).join('&');
    }
    function tabHref(nextStatus) {
      var params = { tab: 'orders' };
      if (nextStatus) params.status = nextStatus;
      if (q) params.q = q;
      return '/account?' + qs(params);
    }
    function pageHref(nextPage) {
      var params = { tab: 'orders' };
      if (status) params.status = status;
      if (q) params.q = q;
      params.page = nextPage;
      return '/account?' + qs(params);
    }
    function orderHref(code) {
      return '/account/orders/' + encodeURIComponent(String(code || ''));
    }
  %>
  <main id="main-content" class="main-content">
    <div class="wrap page-shell">
      <nav class="bc" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <span aria-current="page">Tài khoản</span>
      </nav>

      <div class="acc-layout">
        <%- include('../partials/account-sidebar', { user: accountUser, tab: tab, processingCount: processingCount }) %>

        <div class="acc-content">
          <% if (tab === 'overview') { %>
            <section class="acc-hero">
              <h1 class="acc-hero-title">Xin chào, <%= accountUser.name || 'bạn' %></h1>
              <p class="acc-hero-sub">Theo dõi đơn hàng và quản lý thông tin tài khoản của bạn.</p>
            </section>

            <div class="acc-stats">
              <%
                var statCards = [
                  { key: 'pending', label: 'Chờ xử lý' },
                  { key: 'confirmed', label: 'Đã xác nhận' },
                  { key: 'shipping', label: 'Đang giao' },
                  { key: 'delivered', label: 'Đã giao' }
                ];
              %>
              <% statCards.forEach(function (card) { %>
                <a class="acc-stat acc-stat--<%= card.key %>" href="<%= tabHref(card.key) %>">
                  <span class="acc-stat-count"><%= Number(counts[card.key]) || 0 %></span>
                  <span class="acc-stat-label"><%= card.label %></span>
                </a>
              <% }) %>
            </div>

            <div class="acc-overview-grid">
              <section class="acc-panel" aria-labelledby="acc-default-address-title">
                <div class="acc-panel-head">
                  <h2 class="acc-panel-title" id="acc-default-address-title">Địa chỉ mặc định</h2>
                  <a class="acc-panel-link" href="/account?tab=addresses">Sổ địa chỉ</a>
                </div>
                <% if (defaultAddress) { %>
                  <div class="acc-address-card">
                    <div class="acc-address-head">
                      <p class="acc-address-name"><%= defaultAddress.recipient || defaultAddress.label || 'Người nhận' %></p>
                      <% if (defaultAddress.isDefault) { %>
                        <span class="acc-badge acc-badge--default">Mặc định</span>
                      <% } %>
                    </div>
                    <p class="acc-address-text"><%= defaultAddress.phone || '—' %></p>
                    <p class="acc-address-text"><%= addressFull(defaultAddress) %></p>
                  </div>
                <% } else { %>
                  <div class="acc-empty">
                    <p class="acc-empty-title">Chưa có địa chỉ giao hàng</p>
                    <p class="acc-empty-text">Thêm địa chỉ để thanh toán nhanh hơn ở lần mua tiếp theo.</p>
                    <a class="btn btn-primary btn-sm" href="/address/new">Thêm địa chỉ mới</a>
                  </div>
                <% } %>
              </section>

              <section class="acc-panel" aria-labelledby="acc-recent-orders-title">
                <div class="acc-panel-head">
                  <h2 class="acc-panel-title" id="acc-recent-orders-title">Đơn hàng gần đây</h2>
                  <a class="acc-panel-link" href="/account?tab=orders">Xem tất cả</a>
                </div>
                <% if (recentOrders.length === 0) { %>
                  <div class="acc-empty">
                    <p class="acc-empty-title">Chưa có đơn hàng</p>
                    <p class="acc-empty-text">Các đơn hàng mới nhất của bạn sẽ hiển thị tại đây.</p>
                    <a class="btn btn-primary btn-sm" href="/catalog">Mua sắm ngay</a>
                  </div>
                <% } else { %>
                  <div class="acc-recent-list">
                    <% recentOrders.forEach(function (order) { %>
                      <div class="acc-recent-item">
                        <div class="acc-recent-main">
                          <p class="acc-recent-code"><%= order.code || '—' %></p>
                          <p class="acc-recent-date"><%= fmtDate(order.createdAt) %></p>
                        </div>
                        <div class="acc-recent-side">
                          <span class="<%= statusClass(order.status) %>"><%= statusLabel(order.status) %></span>
                          <span class="acc-recent-total"><%= money(order.total) %></span>
                          <a class="acc-panel-link" href="<%= orderHref(order.code) %>">Chi tiết</a>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </section>
            </div>
          <% } %>

          <% if (tab === 'orders') { %>
            <section class="acc-panel" aria-labelledby="acc-orders-title">
              <div class="acc-panel-head">
                <h2 class="acc-panel-title" id="acc-orders-title">Đơn hàng của tôi</h2>
                <span class="acc-panel-link"><%= totalOrders %> đơn</span>
              </div>

              <nav class="acc-tabs" aria-label="Lọc đơn hàng theo trạng thái">
                <a class="acc-tab<%= status === '' ? ' is-active' : '' %>" href="<%= tabHref('') %>" <%= status === '' ? 'aria-current="page"' : '' %>>
                  Tất cả <span class="acc-tab-count"><%= totalOrders %></span>
                </a>
                <% STATUS_ORDER.forEach(function (key) { %>
                  <a class="acc-tab<%= status === key ? ' is-active' : '' %>" href="<%= tabHref(key) %>" <%= status === key ? 'aria-current="page"' : '' %>>
                    <%= STATUS_LABELS[key] %> <span class="acc-tab-count"><%= Number(counts[key]) || 0 %></span>
                  </a>
                <% }) %>
              </nav>

              <form class="acc-search" method="GET" action="/account" role="search">
                <input type="hidden" name="tab" value="orders">
                <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
                <div class="acc-search-field">
                  <input
                    class="acc-search-input"
                    type="search"
                    name="q"
                    value="<%= q %>"
                    placeholder="Tìm theo mã đơn hoặc tên sản phẩm"
                    aria-label="Tìm đơn hàng"
                    autocomplete="off"
                  >
                </div>
                <button type="submit" class="btn btn-primary btn-sm">Tìm kiếm</button>
                <% if (q) { %>
                  <a class="acc-search-clear" href="<%= tabHref(status) %>">Xóa lọc</a>
                <% } %>
              </form>

              <% if (orders.length === 0) { %>
                <div class="acc-empty">
                  <p class="acc-empty-title"><%= EMPTY_TITLES[status] || EMPTY_TITLES[''] %></p>
                  <p class="acc-empty-text">
                    <% if (q) { %>
                      Không tìm thấy đơn hàng phù hợp với từ khóa “<%= q %>”.
                    <% } else { %>
                      Khi có đơn hàng, thông tin sẽ hiển thị tại đây.
                    <% } %>
                  </p>
                  <a class="btn btn-primary" href="/catalog">Mua sắm ngay</a>
                </div>
              <% } else { %>
                <div class="acc-order-list">
                  <% orders.forEach(function (order) {
                    var items = Array.isArray(order.items) ? order.items : [];
                    var shown = items.slice(0, 3);
                    var rest = Math.max(0, items.length - shown.length);
                  %>
                    <article class="acc-order-card">
                      <header class="acc-order-head">
                        <div>
                          <p class="acc-order-code"><%= order.code || '—' %></p>
                          <p class="acc-order-date"><%= fmtDate(order.createdAt) %></p>
                        </div>
                        <span class="<%= statusClass(order.status) %>"><%= statusLabel(order.status) %></span>
                      </header>

                      <div class="acc-order-items">
                        <% shown.forEach(function (item) { %>
                          <div class="acc-order-item">
                            <span class="acc-thumb">
                              <% if (hasImage(item.image)) { %>
                                <img src="<%= item.image %>" alt="<%= item.name || 'Sản phẩm' %>" loading="lazy" decoding="async">
                              <% } else { %>
                                <span class="acc-thumb-fallback" aria-hidden="true"><%= String(item.name || '?').trim().charAt(0).toUpperCase() || '?' %></span>
                              <% } %>
                            </span>
                            <div class="acc-order-item-main">
                              <p class="acc-order-item-name"><%= item.name || 'Sản phẩm' %></p>
                              <p class="acc-order-item-meta">
                                <% if (item.color) { %><span>Màu: <%= item.color %></span><% } %>
                                <% if (item.size) { %><span>Size: <%= item.size %></span><% } %>
                                <span>x<%= Number(item.qty) || 1 %></span>
                              </p>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                      <% if (rest > 0) { %>
                        <p class="acc-order-more">và <%= rest %> sản phẩm khác</p>
                      <% } %>

                      <footer class="acc-order-foot">
                        <p class="acc-order-total">Tổng tiền <strong><%= money(order.total) %></strong></p>
                        <a class="btn btn-primary btn-sm" href="<%= orderHref(order.code) %>">Xem chi tiết</a>
                      </footer>
                    </article>
                  <% }) %>
                </div>

                <% if (pagination && pagination.totalPages > 1) {
                  var currentPage = pagination.page;
                  var totalPages = pagination.totalPages;
                  var startPage = Math.max(1, currentPage - 2);
                  var endPage = Math.min(totalPages, currentPage + 2);
                %>
                  <nav class="acc-pagination" aria-label="Phân trang đơn hàng">
                    <a class="acc-pg<%= currentPage <= 1 ? ' is-disabled' : '' %>" href="<%= currentPage <= 1 ? '#' : pageHref(currentPage - 1) %>" <%= currentPage <= 1 ? 'aria-disabled="true" tabindex="-1"' : '' %>>Trước</a>
                    <% if (startPage > 1) { %>
                      <a class="acc-pg" href="<%= pageHref(1) %>">1</a>
                      <% if (startPage > 2) { %><span class="acc-pg-ellipsis">…</span><% } %>
                    <% } %>
                    <% for (var pageNo = startPage; pageNo <= endPage; pageNo += 1) { %>
                      <a class="acc-pg<%= pageNo === currentPage ? ' is-current' : '' %>" href="<%= pageHref(pageNo) %>" <%= pageNo === currentPage ? 'aria-current="page"' : '' %>><%= pageNo %></a>
                    <% } %>
                    <% if (endPage < totalPages) { %>
                      <% if (endPage < totalPages - 1) { %><span class="acc-pg-ellipsis">…</span><% } %>
                      <a class="acc-pg" href="<%= pageHref(totalPages) %>"><%= totalPages %></a>
                    <% } %>
                    <a class="acc-pg<%= currentPage >= totalPages ? ' is-disabled' : '' %>" href="<%= currentPage >= totalPages ? '#' : pageHref(currentPage + 1) %>" <%= currentPage >= totalPages ? 'aria-disabled="true" tabindex="-1"' : '' %>>Sau</a>
                  </nav>
                <% } %>
              <% } %>
            </section>
          <% } %>

          <% if (tab === 'addresses') { %>
            <section class="acc-panel" aria-labelledby="acc-addresses-title">
              <div class="acc-panel-head">
                <h2 class="acc-panel-title" id="acc-addresses-title">Sổ địa chỉ</h2>
                <a class="btn btn-primary btn-sm" href="/address/new">Thêm địa chỉ mới</a>
              </div>

              <% if (addresses.length === 0) { %>
                <div class="acc-empty">
                  <p class="acc-empty-title">Chưa có địa chỉ nào</p>
                  <p class="acc-empty-text">Lưu địa chỉ giao hàng để thanh toán nhanh hơn.</p>
                  <a class="btn btn-primary" href="/address/new">Thêm địa chỉ mới</a>
                </div>
              <% } else { %>
                <div class="acc-address-list">
                  <% addresses.forEach(function (addr) {
                    var addressId = addr && addr._id ? String(addr._id) : '';
                    var recipient = (addr && (addr.recipient || addr.label)) || 'Người nhận';
                  %>
                    <article
                      class="acc-address-card"
                      data-acc-address
                      data-id="<%= addressId %>"
                      data-recipient="<%= recipient %>"
                      data-phone="<%= (addr && addr.phone) || '' %>"
                      data-city="<%= (addr && addr.city) || '' %>"
                      data-district="<%= (addr && addr.district) || '' %>"
                      data-ward="<%= (addr && addr.ward) || '' %>"
                      data-street="<%= (addr && addr.street) || '' %>"
                    >
                      <div class="acc-address-head">
                        <p class="acc-address-name"><%= recipient %></p>
                        <% if (addr && addr.isDefault) { %>
                          <span class="acc-badge acc-badge--default">Mặc định</span>
                        <% } %>
                      </div>
                      <p class="acc-address-text"><%= (addr && addr.phone) || '—' %></p>
                      <p class="acc-address-text"><%= addressFull(addr) %></p>
                      <div class="acc-address-actions">
                        <button type="button" class="btn btn-sm btn-ghost" data-acc-edit>Sửa</button>
                        <button type="button" class="btn btn-sm btn-danger" data-acc-delete>Xóa</button>
                      </div>
                    </article>
                  <% }) %>
                </div>
                <p class="acc-address-note">Bạn có thể lưu tối đa 3 địa chỉ.</p>

                <dialog id="accAddressDialog" class="acc-dialog" aria-labelledby="accAddressDialogTitle">
                  <form id="accAddressForm" class="acc-dialog-form" novalidate>
                    <h2 class="acc-dialog-title" id="accAddressDialogTitle">Sửa địa chỉ</h2>
                    <input type="hidden" name="id" value="">
                    <div class="acc-field">
                      <label for="acc-edit-name">Họ và tên</label>
                      <input class="input" type="text" id="acc-edit-name" name="fullName" maxlength="80" required>
                    </div>
                    <div class="acc-field">
                      <label for="acc-edit-phone">Số điện thoại</label>
                      <input class="input" type="tel" id="acc-edit-phone" name="phone" maxlength="12" required>
                    </div>
                    <div class="acc-field">
                      <label for="acc-edit-province">Tỉnh/Thành phố</label>
                      <input class="input" type="text" id="acc-edit-province" name="province" maxlength="100" required>
                    </div>
                    <div class="acc-field">
                      <label for="acc-edit-district">Quận/Huyện</label>
                      <input class="input" type="text" id="acc-edit-district" name="district" maxlength="100">
                    </div>
                    <div class="acc-field">
                      <label for="acc-edit-ward">Phường/Xã</label>
                      <input class="input" type="text" id="acc-edit-ward" name="ward" maxlength="100" required>
                    </div>
                    <div class="acc-field">
                      <label for="acc-edit-detail">Địa chỉ cụ thể</label>
                      <input class="input" type="text" id="acc-edit-detail" name="detail" maxlength="200" required>
                    </div>
                    <div class="acc-dialog-actions">
                      <button type="button" class="btn btn-ghost" data-acc-cancel>Hủy</button>
                      <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                  </form>
                </dialog>
              <% } %>
            </section>
          <% } %>

          <% if (tab === 'profile') { %>
            <section class="acc-panel" aria-labelledby="acc-profile-title">
              <div class="acc-panel-head">
                <h2 class="acc-panel-title" id="acc-profile-title">Hồ sơ</h2>
              </div>
              <dl class="acc-profile-list">
                <div class="acc-profile-row">
                  <dt class="acc-profile-label">Họ và tên</dt>
                  <dd class="acc-profile-value"><%= accountUser.name || '—' %></dd>
                </div>
                <div class="acc-profile-row">
                  <dt class="acc-profile-label">Email</dt>
                  <dd class="acc-profile-value"><%= accountUser.email || '—' %></dd>
                </div>
                <div class="acc-profile-row">
                  <dt class="acc-profile-label">Số điện thoại</dt>
                  <dd class="acc-profile-value"><span data-phone-value><%= accountUser.phoneMasked || '' %></span><% if (accountUser.phoneVerified) { %><span class="acc-badge acc-badge--verified" data-phone-badge="verified">Đã xác thực</span><% } else { %><span class="acc-badge acc-badge--unverified" data-phone-badge="unverified">Chưa xác thực</span><% } %></dd>
                </div>
                <div class="acc-profile-row">
                  <dt class="acc-profile-label">Ngày tham gia</dt>
                  <dd class="acc-profile-value"><%= fmtDate(accountUser.createdAt) %></dd>
                </div>
              </dl>
              <div class="acc-profile-actions">
                <a class="btn btn-primary" href="/profile">Chỉnh sửa hồ sơ</a>
                <button type="button" class="btn btn-soft" data-phone-cta="1"><%= accountUser.phone ? 'Xác thực ngay' : 'Cập nhật số điện thoại' %></button>
              </div>
            </section>
          <% } %>
        </div>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <%- include('../partials/phone-verify-modal') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/account.js"></script>
  <script src="/js/account-page.js"></script>
  <script src="/js/phone-verify.js" defer></script>
</body>
</html>
