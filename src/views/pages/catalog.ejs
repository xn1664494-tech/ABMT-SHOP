<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content" class="main-content">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="section head-section" style="background: var(--canvas); padding: 16px 0 8px;">
      <div class="container">
        <ol class="breadcrumb" style="display: flex; gap: 8px; list-style: none; margin: 0; flex-wrap: wrap;">
          <li><a href="/">Trang chủ</a></li>
          <li><a href="/catalog">Bộ lọc</a></li>
        </ol>
      </div>
    </nav>

    <!-- Filter Form -->
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <form id="filter-form" action="/catalog" method="GET" class="filter-form">
          <div class="section-head" style="gap: 16px; align-items: flex-start; flex-wrap: wrap;">
            <div class="filter-group" style="display: flex; flex-direction: column; gap: 6px; width: 100%;">
              <label class="label" for="category">Danh mục</label>
              <select name="category" id="category" class="select" aria-label="Chọn danh mục">
                <option value="">-- Chọn danh mục --</option>
                <% if (categories) { %>
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat.slug %>" <%= (locals.category === cat.slug ? 'selected' : '') %>><%= cat.name %></option>
                <% }) %>
                <% }) %>
                <% } %>
              </select>
            </div>
            <div class="filter-group" style="display: flex; flex-direction: column; gap: 6px; width: 100%;">
              <label class="label" for="size">Kích cỡ (Size)</label>
              <select name="size" id="size" class="select" aria-label="Chọn kích cỡ">
                <option value="">-- Chọn size --</option>
                <% if (sizes) { %>
                <% sizes.forEach(function(size) { %>
                  <option value="<%= size %>" <%= (locals.size === size ? 'selected' : '') %>><%= size %></option>
                <% }) %>
                <% } %>
              </select>
            </div>
            <div class="filter-group" style="display: flex; flex-direction: column; gap: 6px; width: 100%;">
              <label class="label" for="price-min">Khoảng giá</label>
              <div style="display: grid; gap: 6px;">
                <input type="number" name="price_min" id="price-min" class="input" placeholder="Từ" min="0" step="1000" value="<%= locals.price_min || '' %>" aria-label="Giá tối thiểu">
                <span style="color: var(--muted);">đến</span>
                <input type="number" name="price_max" id="price-max" class="input" đến" min="0" step="1000" value="<%= locals.price_max || '' %>" aria-label="Giá tối đa">
              </div>
            </div>
            <div class="filter-group" style="display: flex; flex-direction: column; gap: 6px; width: 100%;">
              <label class="label" for="material">Chất liệu</label>
              <select name="material" id="material" class="select" aria-label="Chọn chất liệu">
                <option value="">-- Chọn chất liệu --</option>
                <% if (materials) { %>
                <% materials.forEach(function(mat) { %>
                  <option value="<%= mat %>" <%= (locals.material === mat ? 'selected' : '') %>><%= mat %></option>
                <% }) %>
                <% } %>
              </select>
            </div>
          </div>
          <div style="margin-top: 14px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <button type="submit" class="btn btn-primary" style="height: auto; padding: 8px 20px; font-size: 13px;">Áp dụng bộ lọc</button>
            <% if (locals.category || locals.size || locals.price_min || locals.price_max || locals.material) { %>
            <a href="/catalog" class="btn btn-ghost" style="height: auto; padding: 8px 20px; font-size: 13px;">Xóa bộ lọc</a>
            <% } %>
          </div>
        </form>
      </div>
    </section>

    <!-- Sort -->
    <% if (sortBy) { %>
    <div class="section-head" style="margin-bottom: 12px; gap: 8px; flex-wrap: wrap;">
      <span style="font-size: 13px; color: var(--muted);">Sắp xếp: </span>
      <select style="font-size: 13px; padding: 4px 8px;" onchange="this.form.submit()" aria-label="Sắp xếp">
        <option value="newest" <%= (sortBy === 'newest' ? 'selected' : '') %>>Mới nhất</option>
        <option value="price-asc" <%= (sortBy === 'price-asc' ? 'selected' : '') %>>Giá tăng</option>
        <option value="price-desc" <%= (sortBy === 'price-desc' ? 'selected' : '') %>>Giá giảm</option>
      </select>
    </div>
    <% } %>

    <!-- Products Grid -->
    <section id="section-catalog" class="section">
      <div class="container">
        <div class="product-grid">
          <% if (products && products.length > 0) { %>
          <% products.forEach(function(product) { %>
            <%- include('../partials/product-card', { product: product }) %>
          <% }) %>
          <% } else { %>
          <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--muted);">
            Không tìm thấy sản phẩm phù hợp với bộ lọc của bạn.
          </div>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Pagination -->
    <% if (totalPages && totalPages > 1) { %>
    <div class="section-head" style="margin-top: 24px; gap: 8px;">

      <% if (currentPage > 1) { %>
      <a href="?page=<%= currentPage - 1 %>&<%= new URLSearchParams(window.location.search).toString().replace('page=', '') %>" class="page-link" aria-label="Trang trước">Trang trước</a>
      <% } %>

      <% for (var i = 1; i <= totalPages; i++) { %>
      <% if (i === currentPage) { %>
      <span class="page-link" style="color: var(--ink); font-weight: 500;"><%= i %></span>
      <% } else { %>
      <a href="?page=<%= i %>&<%= new URLSearchParams(window.location.search).toString().replace('page=', '') %>" class="page-link" aria-label="Trang <%= i %>"><%= i %></a>
      <% } %>
      <% } %>

      <% if (currentPage < totalPages) { %>
      <a href="?page=<%= currentPage + 1 %>&<%= new URLSearchParams(window.location.search).toString().replace('page=', '') %>" class="page-link" aria-label="Trang sau">Trang sau</a>
      <% } %>
    </div>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/catalog.js"></script>
</body>
</html>