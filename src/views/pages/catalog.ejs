<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <div data-flash data-type="info" hidden></div>
  <%
    var L = (locals && locals.locals) ? locals.locals : (locals || {});
    var items = (typeof products !== 'undefined' && Array.isArray(products)) ? products : [];
    var pg = (typeof pagination !== 'undefined' && pagination) ? pagination : { page: 1, total: 0, totalPages: 0, itemCount: 0 };
    var sortVal = (typeof sortBy !== 'undefined' && sortBy) ? sortBy : 'newest';
    var categoryList = (typeof categories !== 'undefined' && Array.isArray(categories)) ? categories : [];
    var sizeList = (typeof sizes !== 'undefined' && Array.isArray(sizes)) ? sizes : [];
    var colorList = (typeof colors !== 'undefined' && Array.isArray(colors)) ? colors : [];
    var currentPageNum = Number(pg.page) || 1;
    var totalPagesNum = Number(pg.totalPages) || 0;
    var qp = [];
    if (L.category) qp.push('category=' + encodeURIComponent(L.category));
    if (L.size) qp.push('size=' + encodeURIComponent(L.size));
    if (L.color) qp.push('color=' + encodeURIComponent(L.color));
    if (L.keyword) qp.push('keyword=' + encodeURIComponent(L.keyword));
    if (L.inStock) qp.push('inStock=' + encodeURIComponent(L.inStock));
    if (L.price_min) qp.push('minPrice=' + encodeURIComponent(L.price_min));
    if (L.price_max) qp.push('maxPrice=' + encodeURIComponent(L.price_max));
    if (sortVal && sortVal !== 'newest') qp.push('sort=' + encodeURIComponent(sortVal));
    var baseQuery = qp.length ? '?' + qp.join('&') + '&page=' : '?page=';
    var cc = (typeof currentCategory !== 'undefined' && currentCategory) ? currentCategory : null;
    var rc = (typeof rootCategory !== 'undefined' && rootCategory) ? rootCategory : null;
    var childCats = (typeof childCategories !== 'undefined' && Array.isArray(childCategories)) ? childCategories : [];
    var rootCats = (typeof rootCategories !== 'undefined' && Array.isArray(rootCategories)) ? rootCategories : [];
    function chipHref(slug) {
      var parts = [];
      if (slug) parts.push('category=' + encodeURIComponent(slug));
      if (sortVal && sortVal !== 'newest') parts.push('sort=' + encodeURIComponent(sortVal));
      return '/catalog' + (parts.length ? '?' + parts.join('&') : '');
    }
    function isCurrentCat(slug) { return !!(cc && cc.slug === slug); }
  %>
  <main id="main-content" class="main-content">
    <div class="container page-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <% if (rc && cc && cc.slug !== rc.slug) { %>
          <a href="<%= chipHref(rc.slug) %>"><%= rc.name %></a>
          <span class="sep">/</span>
        <% } %>
        <span aria-current="page"><%= cc ? cc.name : 'Sản phẩm' %></span>
      </nav>

      <div class="page-head sh">
        <div>
          <h1 class="page-title"><%= cc ? 'Thời trang ' + cc.name : 'Danh sách sản phẩm' %></h1>
          <p class="page-sub"><%= Number(pg.total) || 0 %> sản phẩm</p>
        </div>
      </div>

      <div class="catalog-chips chips" role="group" aria-label="Chọn danh mục">
        <% if (!rc) { %>
          <a class="catalog-chip<%= !cc ? ' is-current' : '' %>" href="<%= chipHref('') %>">Tất cả</a>
          <% rootCats.forEach(function (cat) { %>
            <a class="catalog-chip" href="<%= chipHref(cat.slug) %>"><%= cat.name %></a>
          <% }) %>
        <% } else { %>
          <a class="catalog-chip<%= isCurrentCat(rc.slug) ? ' is-current' : '' %>" href="<%= chipHref(rc.slug) %>">Tất cả <%= rc.name %></a>
          <% childCats.forEach(function (cat) { %>
            <a class="catalog-chip<%= isCurrentCat(cat.slug) ? ' is-current' : '' %>" href="<%= chipHref(cat.slug) %>"><%= cat.name %></a>
          <% }) %>
        <% } %>
      </div>

      <form id="filter-form" class="catalog-form" action="/catalog" method="get">
        <div class="catalog-toolbar">
          <p class="catalog-count"><%= Number(pg.total) || 0 %> sản phẩm</p>
          <div class="catalog-actions">
            <button type="button" id="filter-toggle" class="btn btn-soft filter-open" aria-expanded="false" aria-controls="filter-drawer">
              Bộ lọc
            </button>
            <div class="sort-wrap">
              <label class="sort-label" for="sort">Sắp xếp</label>
              <select id="sort" name="sort" class="select sort-select">
                <option value="newest" <%= sortVal === 'newest' ? 'selected' : '' %>>Mới nhất</option>
                <option value="price_asc" <%= sortVal === 'price_asc' ? 'selected' : '' %>>Giá thấp đến cao</option>
                <option value="price_desc" <%= sortVal === 'price_desc' ? 'selected' : '' %>>Giá cao đến thấp</option>
              </select>
              <button type="submit" class="btn btn-ghost btn-sm">Áp dụng</button>
            </div>
          </div>
        </div>

        <div class="catalog-layout">
          <div id="filter-overlay" class="filter-overlay"></div>

          <aside id="filter-drawer" class="filter-drawer" aria-label="Bộ lọc sản phẩm">
            <div class="drawer-head">
              <h2 class="drawer-title">Bộ lọc</h2>
              <button type="button" id="filter-close" class="drawer-close" aria-label="Đóng bộ lọc">×</button>
            </div>

            <div class="filter-form">
              <div class="filter-group">
                <label class="label" for="filter-category">Danh mục</label>
                <select id="filter-category" name="category" class="select">
                  <option value="">Tất cả danh mục</option>
                    <% categoryList.forEach(function (cat) { %>
                      <option value="<%= cat.slug %>" <%= (L.category === cat.slug || (cc && cat._id && cc._id.toString() === cat._id.toString())) ? 'selected' : '' %>><%= cat.name %></option>
                    <% }) %>
                </select>
              </div>

              <div class="filter-group">
                <label class="label" for="filter-size">Kích cỡ</label>
                <select id="filter-size" name="size" class="select">
                  <option value="">Tất cả kích cỡ</option>
                  <% sizeList.forEach(function (size) { %>
                    <option value="<%= size %>" <%= L.size === size ? 'selected' : '' %>><%= size %></option>
                  <% }) %>
                </select>
              </div>

              <div class="filter-group">
                <label class="label" for="filter-color">Màu sắc</label>
                <select id="filter-color" name="color" class="select">
                  <option value="">Tất cả màu sắc</option>
                  <% colorList.forEach(function (color) { %>
                    <option value="<%= color %>" <%= L.color === color ? 'selected' : '' %>><%= color %></option>
                  <% }) %>
                </select>
              </div>

              <div class="filter-group">
                <label class="label" for="filter-instock">Tồn kho</label>
                <select id="filter-instock" name="inStock" class="select">
                  <option value="">Tất cả</option>
                  <option value="true" <%= String(L.inStock) === 'true' || String(L.inStock) === '1' ? 'selected' : '' %>>Chỉ còn hàng</option>
                </select>
              </div>
              <input type="hidden" name="keyword" value="<%= L.keyword || '' %>">

              <div class="filter-group">
                <label class="label" for="price-range">Khoảng giá</label>
                <input type="range" id="price-range" class="price-slider" min="0" max="1000000" step="1000"
                  value="<%= Number(L.price_min) || 0 %>" data-min="0" data-max="1000000" data-step="1000"
                  aria-label="Chọn khoảng giá">
                <div class="price-inputs">
                  <input type="number" id="price-min" name="minPrice" class="input price-input" min="0" max="1000000" step="1000"
                    value="<%= L.price_min || '' %>" placeholder="Từ" aria-label="Giá tối thiểu">
                  <span class="price-dash">–</span>
                  <input type="number" id="price-max" name="maxPrice" class="input price-input" min="0" max="1000000" step="1000"
                    value="<%= L.price_max || '' %>" placeholder="Đến" aria-label="Giá tối đa">
                </div>
              </div>

              <div class="filter-actions">
                <button type="submit" class="btn btn-primary">Áp dụng</button>
                <a href="/catalog" class="btn btn-ghost">Xóa lọc</a>
              </div>
            </div>
          </aside>

          <div class="catalog-results">
            <% if (items.length > 0) { %>
              <div class="catalog-grid grid">
                <% items.forEach(function (item) {
                  var cardProduct = {
                    name: item.name,
                    slug: item.slug,
                    image: (item.images && item.images[0]) || '/images/placeholder/product.svg',
                    price: Number(item.basePrice) || 0,
                    salePrice: null,
                    outOfStock: item.inStock === false
                  };
                %>
                  <%- include('../partials/product-card', { product: cardProduct }) %>
                <% }) %>
              </div>

              <% if (totalPagesNum > 1) {
                var startPage = Math.max(1, currentPageNum - 2);
                var endPage = Math.min(totalPagesNum, startPage + 4);
                startPage = Math.max(1, endPage - 4);
              %>
                <nav class="pagination" aria-label="Phân trang sản phẩm">
                  <% if (currentPageNum > 1) { %>
                    <a class="pager" href="<%= baseQuery + (currentPageNum - 1) %>" aria-label="Trang trước">‹</a>
                  <% } else { %>
                    <span class="pager is-disabled" aria-hidden="true">‹</span>
                  <% } %>

                  <% for (var pageNum = startPage; pageNum <= endPage; pageNum += 1) { %>
                    <a class="pager<%= pageNum === currentPageNum ? ' is-current' : '' %>"
                      href="<%= baseQuery + pageNum %>"
                      <% if (pageNum === currentPageNum) { %>aria-current="page"<% } %>><%= pageNum %></a>
                  <% } %>

                  <% if (currentPageNum < totalPagesNum) { %>
                    <a class="pager" href="<%= baseQuery + (currentPageNum + 1) %>" aria-label="Trang sau">›</a>
                  <% } else { %>
                    <span class="pager is-disabled" aria-hidden="true">›</span>
                  <% } %>
                </nav>
              <% } %>
            <% } else { %>
              <div class="empty-state">
                <p class="empty-state-title">Không tìm thấy sản phẩm</p>
                <p class="empty-state-text">Thử bỏ bớt bộ lọc hoặc khám phá toàn bộ danh mục của chúng tôi.</p>
                <% if (rc) { %>
                  <a href="<%= chipHref(rc.slug) %>" class="btn btn-primary">Tất cả đồ <%= rc.name %></a>
                <% } else { %>
                  <a href="<%= chipHref('') %>" class="btn btn-primary">Xem tất cả sản phẩm</a>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      </form>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/catalog.js"></script>
</body>
</html>
