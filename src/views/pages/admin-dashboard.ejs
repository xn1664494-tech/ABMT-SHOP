<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('../partials/header') %>
  <div data-flash data-type="info" hidden></div>
  <%
    var L = (locals && locals.locals) ? locals.locals : (locals || {});
    var stats = (L && L.stats) ? L.stats : {};
    var recentOrders = Array.isArray(L.recentOrders) ? L.recentOrders : [];
    var lowStockProducts = Array.isArray(L.lowStockProducts) ? L.lowStockProducts : [];
    var totalProducts = Number(stats.totalProducts) || 0;
    var totalOrders = Number(stats.totalOrders) || 0;
    var totalRevenue = Number(stats.totalRevenue) || 0;
    var activeUsers = Number(stats.activeUsers) || 0;

    function formatDate(value) {
      var d = new Date(value);
      if (isNaN(d.getTime())) return '';
      return d.toLocaleDateString('vi-VN');
    }

    var revenueMap = {};
    recentOrders.forEach(function (order) {
      var d = new Date(order.createdAt);
      if (isNaN(d.getTime())) return;
      var key = d.toISOString().slice(0, 10);
      revenueMap[key] = (revenueMap[key] || 0) + (Number(order.total) || 0);
    });

    var revenueLabels = [];
    var revenueValues = [];
    var today = new Date();
    today.setHours(0, 0, 0, 0);
    for (var dayOffset = 6; dayOffset >= 0; dayOffset -= 1) {
      var day = new Date(today.getTime() - dayOffset * 86400000);
      var dayKey = day.toISOString().slice(0, 10);
      revenueLabels.push(day.getDate() + '/' + (day.getMonth() + 1));
      revenueValues.push(revenueMap[dayKey] || 0);
    }

    var chartData = {
      revenue: { labels: revenueLabels, data: revenueValues },
      donut: {
        labels: ['Sắp hết hàng', 'Còn hàng'],
        data: [lowStockProducts.length, Math.max(0, totalProducts - lowStockProducts.length)]
      }
    };
  %>
  <main id="main-content" class="main-content">
    <div class="container admin-shell">
      <div class="admin-topbar">
        <button type="button" id="tg" class="admin-menu-btn" aria-label="Mở menu quản trị" aria-controls="sb" aria-expanded="false">☰</button>
        <span class="admin-brand">ABMT ADMIN</span>
      </div>

      <div class="admin-scrim" id="scrim"></div>

      <div class="admin-layout">
        <aside class="admin-sidebar" id="sb" aria-label="Điều hướng quản trị">
          <div class="admin-side-head">
            <span class="admin-side-title">ABMT ADMIN</span>
            <button type="button" class="admin-side-close" aria-label="Đóng menu">×</button>
          </div>
          <nav class="admin-nav">
            <a href="/admin" class="is-active" aria-current="page">Tổng quan</a>
            <a href="/admin/products/new">Thêm sản phẩm</a>
            <a href="/catalog">Xem cửa hàng</a>
            <a href="/account">Tài khoản</a>
          </nav>
        </aside>

        <div class="admin-main">
          <div class="page-head">
            <div>
              <h1 class="page-title">Tổng quan</h1>
              <p class="page-sub">Theo dõi hoạt động kinh doanh của cửa hàng</p>
            </div>
            <a href="/admin/products/new" class="btn btn-primary btn-sm">Thêm sản phẩm</a>
          </div>

          <div class="metric-grid">
            <div class="metric-card">
              <span class="metric-label">Doanh thu</span>
              <span class="metric-value metric-accent" id="vRev"><%= totalRevenue.toLocaleString('vi-VN') %>₫</span>
            </div>
            <div class="metric-card">
              <span class="metric-label">Đơn hàng</span>
              <span class="metric-value" id="vOrd"><%= totalOrders %></span>
            </div>
            <div class="metric-card">
              <span class="metric-label">Sản phẩm</span>
              <span class="metric-value"><%= totalProducts %></span>
            </div>
            <div class="metric-card">
              <span class="metric-label">Khách hàng</span>
              <span class="metric-value"><%= activeUsers %></span>
            </div>
          </div>

          <div class="chart-grid">
            <section class="admin-panel" aria-labelledby="chart-title">
              <div class="admin-panel-head">
                <h2 class="admin-panel-title" id="chart-title">Doanh thu 7 ngày</h2>
                <span class="admin-panel-note">Đơn đã giao</span>
              </div>
              <div class="chart-box">
                <canvas id="chart" height="240" aria-label="Biểu đồ doanh thu 7 ngày" role="img"></canvas>
                <p class="chart-fallback" data-chart-fallback hidden></p>
              </div>
            </section>

            <section class="admin-panel" aria-labelledby="donut-title">
              <div class="admin-panel-head">
                <h2 class="admin-panel-title" id="donut-title">Tình trạng tồn kho</h2>
                <a href="/catalog" class="admin-panel-link">Xem sản phẩm</a>
              </div>
              <div class="chart-box">
                <canvas id="donut" height="240" aria-label="Biểu đồ tình trạng tồn kho" role="img"></canvas>
                <p class="chart-fallback" data-chart-fallback hidden></p>
              </div>
            </section>
          </div>

          <div class="chart-grid">
            <section class="admin-panel" aria-labelledby="recent-title">
              <div class="admin-panel-head">
                <h2 class="admin-panel-title" id="recent-title">Đơn hàng gần đây</h2>
              </div>
              <% if (recentOrders.length > 0) { %>
                <div class="admin-list">
                  <% recentOrders.forEach(function (order) { %>
                    <div class="admin-list-item">
                      <div class="admin-list-main">
                        <span class="admin-list-title"><%= order.code || 'Đơn hàng' %></span>
                        <span class="admin-list-sub"><%= order.customerName || 'Khách hàng' %> · <%= formatDate(order.createdAt) %></span>
                      </div>
                      <span class="admin-list-value"><%= (Number(order.total) || 0).toLocaleString('vi-VN') %>₫</span>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="admin-empty">Chưa có đơn hàng nào.</p>
              <% } %>
            </section>

            <section class="admin-panel" aria-labelledby="stock-title">
              <div class="admin-panel-head">
                <h2 class="admin-panel-title" id="stock-title">Sắp hết hàng</h2>
              </div>
              <% if (lowStockProducts.length > 0) { %>
                <div class="admin-list">
                  <% lowStockProducts.forEach(function (product) { %>
                    <div class="admin-list-item">
                      <div class="admin-list-main">
                        <span class="admin-list-title"><%= product.name %></span>
                        <span class="admin-list-sub">Còn lại trong kho</span>
                      </div>
                      <span class="admin-list-value is-danger"><%= Number(product.stock) || 0 %></span>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="admin-empty">Không có sản phẩm nào sắp hết hàng.</p>
              <% } %>
            </section>
          </div>
        </div>
      </div>
    </div>
  </main>
  <%- include('../partials/footer') %>
  <script type="application/json" id="admin-chart-data"><%- JSON.stringify(chartData).replace(/</g, '\\u003c') %></script>
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <!-- Chart.js 4.4.1 - chờ nhóm duyệt CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
