NODE_ENV=development
# Atlas: allowlist IP hiện tại + IP team (Network Access)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
PORT=3000
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=3000
JWT_SECRET=<your_jwt_secret_here>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
APP_ORIGIN=http://localhost:3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Webhook van chuyen: secret so khop header x-carrier-key (bat buoc cho POST /api/shipping/webhook)
CARRIER_WEBHOOK_SECRET=<your_carrier_webhook_secret_here>
# Job tu dong hoan tat don delivered sau N ngay (mac dinh 7)
AUTO_COMPLETE_DAYS=7
# Rate limit cho POST /api/shipping/webhook trong 1 phut (mac dinh 60)
SHIPPING_WEBHOOK_RATE_LIMIT_MAX=60
# Reset password: thoi han token tinh bang ms (mac dinh 15 phut)
RESET_PASSWORD_TTL_MS=900000
# Ban chay: cua so ngay va nguong so luong toi thieu (mac dinh 90 ngay / 5 san pham)
BEST_SELLER_WINDOW_DAYS=90
BEST_SELLER_MIN_UNITS=5
