    {
      "name": "Pagination - sort price_desc giam dan",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?sort=price_desc&limit=100&category={{categoryId}}&keyword={{keyword}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "sort", "value": "price_desc" },
            { "key": "limit", "value": "100" },
            { "key": "category", "value": "{{categoryId}}" },
            { "key": "keyword", "value": "{{keyword}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status la 200', function () { pm.response.to.have.status(200); });",
              "pm.test('price_desc giam dan', function () {",
              "  var prices = pm.response.json().data.items.map(function (item) { return item.basePrice; });",
              "  for (var i = 1; i < prices.length; i += 1) {",
              "    pm.expect(prices[i]).to.be.at.most(prices[i - 1]);",
              "  }",
              "});"
            ]
          }
        }
      ]
