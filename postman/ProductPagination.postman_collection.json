    {
      "name": "Pagination - Trang 1 limit 2 sort tang dan",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?page=1&limit=2&sort=price_asc&category={{categoryId}}&keyword={{keyword}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "2" },
            { "key": "sort", "value": "price_asc" },
            { "key": "category", "value": "{{categoryId}}" },
            { "key": "keyword", "value": "{{keyword}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status la 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('Trang 1 co 2 san pham', function () { pm.expect(body.data.items.length).to.eql(2); });",
              "pm.test('Pagination dung page/limit/total', function () {",
              "  pm.expect(body.data.pagination.page).to.eql(1);",
              "  pm.expect(body.data.pagination.limit).to.eql(2);",
              "  pm.expect(body.data.pagination.total).to.eql(5);",
              "  pm.expect(body.data.pagination.totalPages).to.eql(3);",
              "});",
              "pm.test('price_asc tang dan', function () {",
              "  var prices = body.data.items.map(function (item) { return item.basePrice; });",
              "  pm.expect(prices[0]).to.be.at.most(prices[1]);",
              "});",
              "pm.collectionVariables.set('page1Ids', JSON.stringify(body.data.items.map(function (item) { return item.id; })));"
            ]
          }
        }
      ]
    },
    {
      "name": "Pagination - Trang 2 limit 2 khong trung trang 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?page=2&limit=2&sort=price_asc&category={{categoryId}}&keyword={{keyword}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "page", "value": "2" },
            { "key": "limit", "value": "2" },
            { "key": "sort", "value": "price_asc" },
            { "key": "category", "value": "{{categoryId}}" },
            { "key": "keyword", "value": "{{keyword}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status la 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('Trang 2 co 2 san pham', function () { pm.expect(body.data.items.length).to.eql(2); });",
              "pm.test('Khong trung san pham voi trang 1', function () {",
              "  var page1 = JSON.parse(pm.collectionVariables.get('page1Ids') || '[]');",
              "  body.data.items.forEach(function (item) { pm.expect(page1).to.not.include(item.id); });",
              "});",
              "pm.test('page = 2', function () { pm.expect(body.data.pagination.page).to.eql(2); });"
            ]
          }
        }
      ]
    },
