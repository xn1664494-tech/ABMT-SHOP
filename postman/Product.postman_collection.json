      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status la 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Tra thanh cong', function () { pm.expect(pm.response.json().success).to.equal(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Product - Khong con thay sau xoa (cong khai)",
      "request": {
