    {
      "name": "Product - Admin xem san pham da xoa (includeDeleted)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/products/{{productId}}?includeDeleted=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status la 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Id trung khop', function () { pm.expect(pm.response.json().data.id).to.equal(pm.collectionVariables.get('productId')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Product - Xoa lan hai (nho 404)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
