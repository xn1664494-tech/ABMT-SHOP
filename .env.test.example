# Sao chép file này thành .env.test (file .env.test KHÔNG được commit)
NODE_ENV=test

# CSDL dành riêng cho test. Tên database BẮT BUỘC chứa chữ "test".
# Khuyến nghị dùng MongoDB local cho integration test.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/abmt_shop_test

# Nếu bắt buộc dùng Atlas cho test, dùng một database riêng có tên chứa "test":
# MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/abmt_shop_test

# LƯU Ý: không trỏ MONGODB_URI_TEST vào database dev/production.
# Test sẽ từ chối chạy nếu tên database không chứa "test".
#
# Tên cũ `TEST_MONGODB_URI` chỉ còn được hỗ trợ tạm 1 sprint (có cảnh báo deprecated).
