# Sao chép file này thành .env.test (file .env.test KHÔNG được commit)
NODE_ENV=test

# CSDL dành riêng cho test. Tên database BẮT BUỘC chứa chữ "test".
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urbanminimal_test
# Hoặc MongoDB local:
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/urbanminimal_test
